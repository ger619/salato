<% content_for :main_class, "block" %>
<% content_for :title, "Buy tickets — #{@event.name}" %>

<% max_qty    = [@ticket_type.available_quantity.to_i, 10].min %>
<% unit_price = @ticket_type.price.to_i %>

<%= render 'shared/header' %>


<section class="pt-32 lg:pt-40 pb-24 lg:pb-32">
  <div class="max-w-shell mx-auto px-5 lg:px-8">

    <%# ── Back + progress ─────────────────────────────────────── %>
    <%= link_to event_path(@event.slug), class: "inline-flex items-center gap-2 text-[14px] text-ink-soft hover:text-ink transition" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H6M11 18l-6-6 6-6"/></svg>
      Back to <%= @event.name %>
    <% end %>

    <div class="mt-8 flex items-center gap-3 text-[13px] font-medium">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg grad-bg text-white">
        <span class="font-mono text-[11px]">1</span> Your details
      </span>
      <span class="h-px w-6 bg-ink/15" aria-hidden="true"></span>
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-mist text-ink-soft ring-1 ring-ink/8">
        <span class="font-mono text-[11px]">2</span> Payment
      </span>
      <span class="h-px w-6 bg-ink/15" aria-hidden="true"></span>
      <span class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-mist text-ink-soft ring-1 ring-ink/8">
        <span class="font-mono text-[11px]">3</span> Ticket emailed
      </span>
    </div>

    <h1 class="mt-6 text-[34px] lg:text-[44px] leading-[1.06] font-semibold">
      Who are these <span class="grad-text">tickets</span> for?
    </h1>
    <p class="mt-3 text-[17px] text-ink-soft max-w-lg">
      We'll send the ticket to the email you give us. No account needed.
    </p>

    <div class="mt-12 grid lg:grid-cols-[1fr_.8fr] gap-8 lg:gap-12 items-start"
         data-controller="order-total"
         data-order-total-unit-price-value="<%= unit_price %>"
         data-order-total-max-value="<%= max_qty %>">

      <%# ══════════ FORM ══════════ %>
      <div class="order-2 lg:order-1">
        <%= form_with model: [@event, @order], local: true, class: "space-y-6", data: {turbo: false} do |form| %>

          <% if @order.errors.any? %>
            <div class="rounded-[18px] bg-flare/8 ring-1 ring-flare/30 p-6" role="alert">
              <h2 class="text-[16px] font-semibold text-flare">
                <%= pluralize(@order.errors.count, "thing") %> to fix before we can take payment
              </h2>
              <ul class="mt-3 space-y-1.5 text-[15px] text-ink-soft">
                <% @order.errors.full_messages.each do |message| %>
                  <li class="flex gap-2.5">
                    <span class="text-flare mt-0.5" aria-hidden="true">&bull;</span>
                    <span><%= message %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
          <%= form.hidden_field :ticket_type_id, value: @ticket_type.id %>


          <div class="rounded-[20px] bg-white ring-1 ring-ink/12 p-6 lg:p-7 space-y-5">
            <div>
              <%= form.label :customer_name, "Full name",
                    class: "block text-[14px] font-medium mb-2" %>
              <%= form.text_field :customer_name,
                    required: true, autocomplete: "name", placeholder: "Wanjiru Kamau",
                    class: "w-full px-4 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-flare outline-none transition" %>
              <p class="mt-1.5 text-[13px] text-ink-soft/75">This name is printed on the ticket and checked at the gate.</p>
            </div>

            <div>
              <%= form.label :customer_email, "Email address",
                    class: "block text-[14px] font-medium mb-2" %>
              <%= form.email_field :customer_email,
                    required: true, autocomplete: "email", inputmode: "email", placeholder: "you@example.com",
                    class: "w-full px-4 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-flare outline-none transition" %>
              <p class="mt-1.5 text-[13px] text-ink-soft/75">Your ticket lands here the moment payment clears.</p>
            </div>

            <div>
              <%= form.label :customer_phone, "Phone number",
                    class: "block text-[14px] font-medium mb-2" %>
              <%= form.telephone_field :customer_phone,
                    autocomplete: "tel", inputmode: "tel", placeholder: "07XX XXX XXX",
                    class: "w-full px-4 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-flare outline-none transition font-mono" %>
              <p class="mt-1.5 text-[13px] text-ink-soft/75">Paying with M-Pesa? The prompt goes to this number.</p>
            </div>
          </div>

          <%# ── Quantity stepper ── %>
          <div class="rounded-[20px] bg-white ring-1 ring-ink/12 p-6 lg:p-7">
            <%= form.label :quantity, "How many tickets?",
                  class: "block text-[14px] font-medium mb-3" %>

            <div class="flex items-center gap-3">
              <button type="button"
                      class="w-11 h-11 shrink-0 rounded-xl ring-1 ring-ink/15 grid place-items-center hover:bg-mist transition disabled:opacity-35 disabled:cursor-not-allowed"
                      aria-label="One fewer ticket"
                      data-action="order-total#decrement" data-order-total-target="minus">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>
              </button>

              <%= form.number_field :quantity,
                    min: 1, max: max_qty, value: 1, required: true, inputmode: "numeric",
                    data: { order_total_target: "quantity", action: "input->order-total#recalculate" },
                    class: "w-20 text-center px-3 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-flare outline-none transition font-mono text-[17px] font-medium
                            [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" %>

              <button type="button"
                      class="w-11 h-11 shrink-0 rounded-xl ring-1 ring-ink/15 grid place-items-center hover:bg-mist transition disabled:opacity-35 disabled:cursor-not-allowed"
                      aria-label="One more ticket"
                      data-action="order-total#increment" data-order-total-target="plus">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              </button>

              <p class="ms-1 text-[13px] text-ink-soft/75" data-order-total-target="limit" aria-live="polite">
                <%= max_qty %> per order
              </p>
            </div>
          </div>

          <%= form.submit "Continue to payment",
                class: "w-full py-4 rounded-xl font-medium text-[16px] text-white grad-bg hover:brightness-110 transition cursor-pointer shadow-[0_12px_32px_-12px_rgba(225,55,101,.9)]" %>

          <p class="text-[13px] text-ink-soft/75 text-center">
            You'll choose M-Pesa or card on the next screen. Nothing is charged yet.
          </p>
        <% end %>
      </div>

      <%# ══════════ ORDER SUMMARY ══════════ %>
      <aside class="order-1 lg:order-2 lg:sticky lg:top-28">
        <div class="stub rounded-[20px] bg-white ring-1 ring-ink/12 p-6 lg:p-7" style="--ty: calc(100% - 128px)">
          <p class="eyebrow text-magenta">Your order</p>

          <h2 class="mt-3 text-[20px] leading-tight font-semibold"><%= @event.name %></h2>
          <p class="mt-2 text-[14px] text-ink-soft"><%= @event.venue %></p>
          <p class="font-mono text-[13px] text-ink-soft/75 mt-1">
            <%= @event.start_at.strftime("%a %-d %b · %-l:%M %p") %>
          </p>

          <div class="mt-5 pt-5 border-t border-ink/10">
            <div class="flex items-baseline justify-between gap-4">
              <div class="min-w-0">
                <p class="text-[15px] font-medium truncate"><%= @ticket_type.name %></p>
                <p class="font-mono text-[13px] text-ink-soft/75 mt-0.5">
                  KES <%= number_with_delimiter(unit_price) %> each
                </p>
              </div>
              <p class="font-mono text-[15px] shrink-0">
                &times;&nbsp;<span data-order-total-target="count">1</span>
              </p>
            </div>

            <% if ticket_scarcity(@ticket_type.available_quantity.to_i) %>
              <p class="mt-3 inline-block font-mono text-[10px] tracking-[.16em] px-2.5 py-1.5 rounded-lg bg-flare/10 text-flare">
                <%= ticket_scarcity(@ticket_type.available_quantity.to_i) %>
              </p>
            <% end %>
          </div>

          <div class="my-6 relative"><div class="tear"></div></div>

          <div class="flex items-end justify-between gap-4">
            <div>
              <p class="eyebrow text-ink-soft/55">Total</p>
              <p class="mt-1.5 font-display text-[30px] font-semibold leading-none grad-text"
                 data-order-total-target="total" aria-live="polite">
                KES <%= number_with_delimiter(unit_price) %>
              </p>
            </div>
            <p class="text-[12px] text-ink-soft/70 text-right max-w-[9rem] leading-snug">
              All fees included
            </p>
          </div>
        </div>

        <div class="mt-5 rounded-[18px] bg-mist ring-1 ring-ink/8 p-5">
          <p class="eyebrow text-ink-soft/55">What happens next</p>
          <ul class="mt-3 space-y-2.5 text-[14px] text-ink-soft">
            <% ["Pay with M-Pesa or card", "Ticket PDF emailed straight away", "Show the QR code at the gate"].each do |step| %>
              <li class="flex gap-2.5">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                     stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0 text-magenta" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                <span><%= step %></span>
              </li>
            <% end %>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</section>
