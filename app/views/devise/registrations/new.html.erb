<%# app/views/users/registrations/new.html.erb %>
<%
  client_error = resource.errors.attribute_names.any? { |a| a.to_s.start_with?("client") }
%>

<div class="max-w-md mx-auto px-4 py-10"
     data-controller="wizard"
     data-wizard-error-step="<%= client_error ? "2" : "1" %>">

  <div class="flex gap-4 text-xs font-mono uppercase tracking-widest">
    <span data-wizard-target="indicator">1. Your account</span>
    <span data-wizard-target="indicator">2. Organisation</span>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
               html: { class: "mt-8" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%# ---------- PAGE 1 ---------- %>
    <div data-wizard-target="step" class="space-y-4">
      <h1 class="text-3xl font-semibold text-[#150D3A]">Create your account</h1>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :first_name, class: "block text-sm font-medium text-[#150D3A]" %>
          <%= f.text_field :first_name, required: true,
                           class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
        </div>
        <div>
          <%= f.label :last_name, class: "block text-sm font-medium text-[#150D3A]" %>
          <%= f.text_field :last_name, required: true,
                           class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
        </div>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-[#150D3A]" %>
        <%= f.email_field :email, autocomplete: "email", required: true,
                          class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
      </div>

      <div>
        <%= f.label :phone_number, class: "block text-sm font-medium text-[#150D3A]" %>
        <%= f.telephone_field :phone_number, placeholder: "+254 7XX XXX XXX",
                              class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-[#150D3A]" %>
        <%= f.password_field :password, autocomplete: "new-password", required: true,
                             minlength: 6,
                             class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-[#150D3A]" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true,
                             class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
      </div>

      <button type="button" data-action="wizard#next"
              class="w-full rounded-lg bg-gradient-to-r from-[#7620B1] to-[#FC8027]
                     py-3 font-semibold text-white hover:opacity-90">
        Next
      </button>
    </div>

    <%# ---------- PAGE 2 ---------- %>
    <div data-wizard-target="step" class="hidden space-y-4">
      <h1 class="text-3xl font-semibold text-[#150D3A]">Your organisation</h1>
      <p class="text-sm text-gray-600">This appears on your event pages and ticket PDFs.</p>

      <%= f.fields_for :client do |cf| %>
        <div>
          <%= cf.label :name, "Organisation name", class: "block text-sm font-medium text-[#150D3A]" %>
          <%= cf.text_field :name, required: true,
                            class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= cf.label :phone, class: "block text-sm font-medium text-[#150D3A]" %>
            <%= cf.telephone_field :phone, required: true,
                                   class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
          </div>
          <div>
            <%= cf.label :email, "Billing email", class: "block text-sm font-medium text-[#150D3A]" %>
            <%= cf.email_field :email,
                               class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= cf.label :city, class: "block text-sm font-medium text-[#150D3A]" %>
            <%= cf.text_field :city,
                              class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
          </div>
          <div>
            <%= cf.label :country, class: "block text-sm font-medium text-[#150D3A]" %>
            <%= cf.text_field :country, value: cf.object.country.presence || "Kenya",
                              class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
          </div>
        </div>

        <div>
          <%= cf.label :website, class: "block text-sm font-medium text-[#150D3A]" %>
          <%= cf.url_field :website, placeholder: "https://",
                           class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
        </div>

        <div>
          <%= cf.label :description, "Short description", class: "block text-sm font-medium text-[#150D3A]" %>
          <%= cf.text_area :description, rows: 3,
                           class: "mt-1 w-full rounded-lg border-gray-300 focus:border-[#7620B1] focus:ring-[#7620B1]" %>
        </div>
      <% end %>

      <div class="flex gap-3 pt-2">
        <button type="button" data-action="wizard#back"
                class="w-1/3 rounded-lg border border-gray-300 py-3 font-semibold text-[#150D3A] hover:bg-gray-50">
          Back
        </button>
        <%= f.submit "Register",
                     class: "w-2/3 rounded-lg bg-gradient-to-r from-[#7620B1] to-[#FC8027]
                      py-3 font-semibold text-white hover:opacity-90 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>