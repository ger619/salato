<%# app/views/users/registrations/new.html.erb %>
<%
  client_error = resource.errors.attribute_names.any? { |a| a.to_s.start_with?("client") }

  # the full four-stop Salato gradient, not the two-stop shortcut
  grad = "bg-[linear-gradient(105deg,#7620B1_0%,#AB2692_34%,#E13765_62%,#FC8027_100%)]"

  field = "mt-1.5 w-full rounded-xl border-0 bg-white px-3.5 py-2.5 text-[#150D3A] " \
    "font-['Inter_Tight'] ring-1 ring-[#150D3A]/12 placeholder:text-[#150D3A]/35 " \
    "focus:ring-2 focus:ring-[#AB2692] focus:outline-none transition"
  lbl = "block text-sm font-semibold text-[#150D3A] font-['Inter_Tight']"

  cta = "#{grad} rounded-xl py-3.5 font-[Outfit] text-[15px] font-bold tracking-tight text-white " \
    "shadow-lg shadow-[#E13765]/30 transition hover:shadow-xl hover:shadow-[#E13765]/40 " \
    "hover:brightness-105 active:scale-[0.99]"
  ghost = "rounded-xl bg-white py-3.5 font-[Outfit] text-[15px] font-bold text-[#150D3A] " \
    "ring-1 ring-[#150D3A]/15 transition hover:bg-[#F7F4FB] hover:ring-[#7620B1]/30 active:scale-[0.99]"

  review_lbl = "font-['JetBrains_Mono'] text-[10px] uppercase tracking-[0.14em] text-[#7620B1]"
  review_val = "mt-1 font-['Inter_Tight'] text-[15px] font-semibold text-[#150D3A]"
  edit_btn = "rounded-full bg-[#7620B1]/10 px-3.5 py-1.5 font-['Inter_Tight'] text-[13px] " \
    "font-bold text-[#7620B1] transition hover:bg-[#7620B1]/18"
%>

<div class="min-h-screen bg-[#F7F4FB] pt-20 pb-16 sm:pt-28">
  <div class="mx-auto max-w-3xl px-4"
       data-controller="wizard"
       data-wizard-error-step="<%= client_error ? 1 : 0 %>">

    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 ring-1 ring-[#150D3A]/10">
        <span class="h-2 w-2 rounded-full <%= grad %>"></span>
        <span class="font-['JetBrains_Mono'] text-[11px] uppercase tracking-[0.18em] text-[#150D3A]/70">
          Organiser sign up
        </span>
      </div>
    </div>

    <div class="overflow-hidden rounded-3xl bg-white shadow-[0_24px_70px_-24px_rgba(21,13,58,0.35)] ring-1 ring-[#150D3A]/5">
      <div class="h-2 w-full <%= grad %>"></div>

      <%# ---------- STEP INDICATOR ---------- %>
      <div class="flex items-center gap-2.5 px-6 pt-6 sm:gap-3 sm:px-8">
        <% %w[Account Organisation Review].each_with_index do |label, i| %>
          <% if i.positive? %>
            <div class="h-0.5 flex-1 rounded-full bg-[#150D3A]/8"></div>
          <% end %>
          <%# the wizard controller swaps the text colour here; bg-current and %>
          <%# border-current inherit it, so the whole pip recolours at once %>
          <div data-wizard-target="indicator"
               class="flex shrink-0 items-center gap-2.5 <%= i.zero? ? "text-[#7620B1]" : "text-gray-400" %>">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-current
                         font-['JetBrains_Mono'] text-[13px] font-bold text-white">
              <%= i + 1 %>
            </span>
            <span class="hidden font-['JetBrains_Mono'] text-[10px] font-medium uppercase tracking-[0.15em] text-current sm:inline">
              <%= label %>
            </span>
          </div>
        <% end %>
      </div>

      <%# ---------- PERFORATED TEAR ---------- %>
      <div class="relative mt-6">
        <div class="absolute -left-2 top-1/2 h-4 w-4 -translate-y-1/2 rounded-full bg-[#F7F4FB]"></div>
        <div class="absolute -right-2 top-1/2 h-4 w-4 -translate-y-1/2 rounded-full bg-[#F7F4FB]"></div>
        <div class="mx-6 border-t-2 border-dashed border-[#150D3A]/12 sm:mx-8"></div>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                   html: { class: "px-6 pb-8 pt-7 sm:px-8",
                           data: { action: "submit->wizard#onSubmit" } }) do |f| %>

        <% if resource.errors.any? %>
          <div data-flash
               class="flash mb-6 overflow-hidden rounded-2xl bg-[#E13765]/10 ring-1 ring-[#E13765]/30">
            <div class="h-1 w-full <%= grad %>"></div>
            <div class="px-4 py-3">
              <p class="font-[Outfit] text-sm font-bold text-[#E13765]">
                <%= pluralize(resource.errors.count, "field needs", plural: "fields need") %> fixing
              </p>
              <ul class="mt-1.5 space-y-0.5 font-['Inter_Tight'] text-sm text-[#150D3A]/75">
                <% resource.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <%# ═══════════ STEP 1 — ACCOUNT ═══════════ %>

        <%= render "user_input", f: f, lbl: lbl, field: field, cta: cta, ghost: ghost %>

        <%# ═══════════ STEP 2 — ORGANISATION ═══════════ %>

        <%= render "organisation", f: f, lbl: lbl, field: field, cta: cta, ghost: ghost %>

        <%# ═══════════ STEP 3 — REVIEW ═══════════ %>
        <%
          # One summary row. `sources` is the id (or space-separated ids) of
          # the field it mirrors; the wizard controller fills it in.
          review_row = lambda do |label, sources, span: false, format: nil, extra: nil|
            tag.div(class: span ? "sm:col-span-2" : nil) do
              tag.dt(label, class: review_lbl) +
                tag.dd("", class: "#{review_val} #{extra}",
                       data: { wizard_target: "preview",
                               preview_source: sources,
                               preview_format: format }.compact)
            end
          end

          card_head = lambda do |title, step|
            tag.div(class: "flex items-center justify-between gap-3") do
              tag.h2(title, class: "font-[Outfit] text-base font-bold text-[#150D3A]") +
                tag.button("Edit", type: "button", class: edit_btn,
                           data: { action: "wizard#edit", wizard_step_param: step })
            end
          end
        %>

        <div data-wizard-target="step" class="hidden space-y-5">
          <div>
            <h1 class="font-[Outfit] text-2xl font-bold tracking-tight text-[#150D3A] sm:text-3xl">
              Check your details
            </h1>
            <p class="mt-1.5 font-['Inter_Tight'] text-sm text-[#150D3A]/65">
              Nothing is saved until you register.
            </p>
          </div>

          <%# ---- account ---- %>
          <div class="overflow-hidden rounded-2xl bg-[#F7F4FB] ring-1 ring-[#150D3A]/8">
            <div class="h-1 w-full <%= grad %>"></div>
            <div class="p-5">
              <%= card_head.("Account", 0) %>

              <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <%= review_row.("Name", "user_first_name user_last_name") %>
                <%= review_row.("Email", "user_email", extra: "break-all") %>
                <%= review_row.("Phone", "user_phone_number") %>
                <%= review_row.("ID / passport number", "user_id_number") %>
                <%= review_row.("ID document", "user_id_photo", extra: "break-all font-normal") %>

                <div>
                  <dt class="<%= review_lbl %>">Password</dt>
                  <dd class="mt-1 font-['Inter_Tight'] text-[15px] font-semibold tracking-[0.2em] text-[#150D3A]/45">
                    ••••••••
                  </dd>
                </div>
              </dl>
            </div>
          </div>

          <%# ---- organisation ---- %>
          <div class="overflow-hidden rounded-2xl bg-[#F7F4FB] ring-1 ring-[#150D3A]/8">
            <div class="h-1 w-full <%= grad %>"></div>
            <div class="p-5">
              <%= card_head.("Organisation", 1) %>

              <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <%= review_row.("Organisation name", "user_client_attributes_name",
                  span: true, extra: "text-[17px]") %>
                <%= review_row.("Logo", "user_client_attributes_logo", extra: "break-all font-normal") %>
                <%= review_row.("Business phone", "user_client_attributes_phone") %>
                <%= review_row.("Billing email", "user_client_attributes_email", extra: "break-all") %>
                <%= review_row.("City", "user_client_attributes_city") %>
                <%= review_row.("Country", "user_client_attributes_country") %>

                <%# The description is rich text, so it gets its own panel
                    rather than a one-line value. %>
                <div class="sm:col-span-2">
                  <dt class="<%= review_lbl %>">About your events</dt>
                  <dd class="mt-1.5 max-h-56 overflow-y-auto whitespace-pre-line rounded-xl
                             bg-white p-3.5 font-['Inter_Tight'] text-[14px] leading-relaxed
                             text-[#150D3A] ring-1 ring-[#150D3A]/8"
                      data-wizard-target="preview"
                      data-preview-source="user_client_attributes_description"
                      data-preview-format="rich"></dd>
                </div>
              </dl>
            </div>
          </div>

          <%# ---- payout ---- %>
          <div class="overflow-hidden rounded-2xl bg-[#F7F4FB] ring-1 ring-[#150D3A]/8">
            <div class="h-1 w-full <%= grad %>"></div>
            <div class="p-5">
              <%= card_head.("Payout", 1) %>

              <dl class="mt-4 grid gap-4 sm:grid-cols-2">
                <%= review_row.("Payout type", "user_client_attributes_payout_method") %>

                <%# Only the visible payout branch is enabled, so only that
                    one reports a value. %>
                <%= review_row.("Bank / provider",
                  "user_client_attributes_bank user_client_attributes_mobile_money_provider") %>
                <%= review_row.("Account number",
                  "user_client_attributes_account_number mobile_money_number",
                  span: true, extra: "font-['JetBrains_Mono'] tracking-tight") %>
              </dl>

              <p class="mt-4 flex items-start gap-2 font-['Inter_Tight'] text-xs text-[#150D3A]/50">
                <svg class="mt-px h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/>
                </svg>
                Ticket money lands here after each event, less the Salato commission.
              </p>
            </div>
          </div>

          <div class="flex gap-3 pt-2">
            <button type="button" data-action="wizard#back" class="w-1/3 <%= ghost %>">
              Back
            </button>
            <%= f.submit "Register", class: "w-2/3 cursor-pointer #{cta}" %>
          </div>
        </div>

      <% end %>
    </div>

    <p class="mt-6 text-center font-['Inter_Tight'] text-xs text-[#150D3A]/50">
      By registering you agree to Salato's terms and privacy policy.
    </p>
  </div>
</div>
