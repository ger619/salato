<div data-wizard-target="step" class="hidden space-y-5">
  <div>
    <h1 class="font-[Outfit] text-2xl font-bold tracking-tight text-[#150D3A] sm:text-3xl">
      Your organisation
    </h1>
    <p class="mt-1.5 font-['Inter_Tight'] text-sm text-[#150D3A]/65">
      This appears on your event pages and ticket PDFs.
    </p>
  </div>

  <%= f.fields_for :client do |cf| %>
    <div>
      <%= cf.label :name, "Organisation name", class: lbl %>
      <%= cf.text_field :name, required: true,
                        placeholder: "e.g. Salato Events Ltd", class: field %>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <%= cf.label :phone, "Business phone", class: lbl %>
        <%= cf.telephone_field :phone, required: true,
                               placeholder: "+254 7XX XXX XXX", class: field %>
      </div>
      <div>
        <%= cf.label :email, "Billing email", class: lbl %>
        <%= cf.email_field :email, class: field %>
      </div>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <div>
        <%= cf.label :city, class: lbl %>
        <%= cf.text_field :city, placeholder: "Nairobi", class: field %>
      </div>
      <div>
        <%= cf.label :country, class: lbl %>
        <%= cf.text_field :country, value: cf.object.country.presence || "Kenya", class: field %>
      </div>
    </div>

    <div>
      <%= cf.label :description, "Short description", class: lbl %>
      <%= cf.text_area :description, rows: 3,
                       placeholder: "What kind of events do you run?", class: field %>
    </div>
  <% end %>

  <div class="flex gap-3 pt-2">
    <button type="button" data-action="wizard#back" class="w-1/3 <%= ghost %>">
      Back
    </button>
    <button type="button" data-action="wizard#next"
            class="group flex w-2/3 items-center justify-center gap-2 <%= cta %>">
      Review
      <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
    </button>
  </div>
</div>
