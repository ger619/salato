<div data-wizard-target="step" class="hidden space-y-6">

  <div>
    <h1 class="font-[Outfit] text-2xl font-bold tracking-tight text-[#150D3A] sm:text-3xl">
      Your organisation
    </h1>
    <p class="mt-1.5 font-['Inter_Tight'] text-sm text-[#150D3A]/65">
      This appears on your event pages and ticket PDFs.
    </p>
  </div>

  <%= f.fields_for :client do |cf| %>

    <%# ── who you are ── %>
    <div class="space-y-4 rounded-2xl bg-white p-4 ring-1 ring-[#150D3A]/8 sm:p-5">
      <%#
        ── logo ──
        Reuses the poster-upload controller from the event form: same drag,
        drop, preview and client-side size check, just sized for a mark
        rather than a 40vh banner.
      %>
      <div data-controller="poster-upload"
           data-poster-upload-max-size-value="2097152"
           data-poster-upload-accept-value="image/png,image/jpeg,image/webp">

        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <%= cf.label :logo, "Logo", class: lbl %>
          <span class="font-['JetBrains_Mono'] text-[10px] uppercase tracking-[0.14em] text-[#150D3A]/40">
            PNG · JPG · WebP — up to 2 MB
          </span>
        </div>

        <p class="mt-1 font-['Inter_Tight'] text-xs text-[#150D3A]/50">
          Printed on every ticket you sell. A square mark works best.
        </p>

        <%# The real input stays hidden; the zone below drives it. %>
        <%= cf.file_field :logo,
                          accept: "image/png,image/jpeg,image/webp",
                          class: "sr-only",
                          data: { poster_upload_target: "input",
                                  action: "change->poster-upload#fileChosen" } %>

        <%# ── empty state ── %>
        <div data-poster-upload-target="zone"
             data-action="click->poster-upload#browse
                          dragenter->poster-upload#dragEnter
                          dragover->poster-upload#dragEnter
                          dragleave->poster-upload#dragLeave
                          drop->poster-upload#drop
                          keydown.enter->poster-upload#browse
                          keydown.space->poster-upload#browse"
             role="button"
             tabindex="0"
             aria-label="Add your logo"
             class="group mt-2.5 flex w-full cursor-pointer items-center gap-4 rounded-2xl
                    border-2 border-dashed border-[#150D3A]/15 bg-[#F7F4FB] px-4 py-4
                    text-left transition duration-200
                    hover:border-[#7620B1]/45 hover:bg-[#7620B1]/[0.04]
                    focus:outline-none focus-visible:border-[#7620B1]
                    focus-visible:ring-4 focus-visible:ring-[#7620B1]/25
                    data-[dragging]:border-[#7620B1] data-[dragging]:bg-[#7620B1]/[0.07]">

          <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl
                       bg-gradient-to-br from-[#7620B1] to-[#FC8027] text-white
                       shadow-[0_12px_28px_-14px_rgba(118,32,177,0.95)]
                       transition duration-200 group-hover:-translate-y-0.5
                       motion-reduce:transition-none motion-reduce:group-hover:translate-y-0">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 16V4M7 9l5-5 5 5" />
              <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
            </svg>
          </span>

          <span class="min-w-0">
            <span class="block font-[Outfit] text-[15px] font-medium text-[#150D3A]">
              Drop your logo here, or
              <span class="text-[#7620B1] underline decoration-[#7620B1]/30 underline-offset-4">browse</span>
            </span>
            <span class="mt-1 block font-['Inter_Tight'] text-[13px] leading-5 text-[#150D3A]/45">
              Transparent PNG looks cleanest on the ticket stub.
            </span>
          </span>
        </div>

        <%# ── chosen state ── %>
        <div data-poster-upload-target="preview"
             class="mt-2.5 hidden items-center gap-4 rounded-2xl bg-white p-3 ring-1 ring-[#150D3A]/10">

          <span class="grid h-16 w-16 shrink-0 place-items-center overflow-hidden rounded-xl
                       bg-[#F7F4FB] p-2 ring-1 ring-[#150D3A]/8">
            <%= image_tag "", alt: "",
                          class: "h-full w-full object-contain",
                          data: { poster_upload_target: "image",
                                  action: "load->poster-upload#imageLoaded" } %>
          </span>

          <div class="min-w-0 flex-1">
            <p class="truncate font-['Inter_Tight'] text-sm font-medium text-[#150D3A]"
               data-poster-upload-target="filename"></p>
            <p class="mt-0.5 font-['JetBrains_Mono'] text-[11px] text-[#150D3A]/45">
              <span data-poster-upload-target="filesize"></span><span data-poster-upload-target="dimensions"></span>
            </p>
          </div>

          <div class="flex shrink-0 items-center gap-1">
            <button type="button" data-action="poster-upload#browse"
                    class="rounded-lg px-2.5 py-1.5 font-['Inter_Tight'] text-xs font-semibold
                           text-[#7620B1] transition hover:bg-[#7620B1]/8
                           focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1]">
              Replace
            </button>
            <button type="button" data-action="poster-upload#remove"
                    class="rounded-lg px-2.5 py-1.5 font-['Inter_Tight'] text-xs font-medium
                           text-[#150D3A]/50 transition hover:bg-[#150D3A]/5 hover:text-[#150D3A]
                           focus:outline-none focus-visible:ring-2 focus-visible:ring-[#150D3A]/30">
              Remove
            </button>
          </div>
        </div>

        <p data-poster-upload-target="error"
           class="mt-2 hidden font-['Inter_Tight'] text-xs text-[#FC8027]"></p>
      </div>

      <div>
        <%= cf.label :name, "Organisation name", class: lbl %>
        <%= cf.text_field :name, required: true,
                          placeholder: "e.g. Salato Events Ltd", class: field %>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <%= cf.label :phone, "Business phone", class: lbl %>
          <%= cf.telephone_field :phone, required: true,
                                 placeholder: "+254 7XX XXX XXX", class: field %>
        </div>
        <div>
          <%= cf.label :email, "Billing email", class: lbl %>
          <%= cf.email_field :email, placeholder: "billing@yourcompany.com", class: field %>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <%= cf.label :city, class: lbl %>
          <%= cf.text_field :city, placeholder: "Nairobi", class: field %>
        </div>
        <div>
          <%= cf.label :country, class: lbl %>
          <%= cf.text_field :country,
                            value: cf.object&.country.presence || "Kenya",
                            class: field %>
        </div>
      </div>
    </div>
    <div data-controller="payout-details"
         class="rounded-2xl bg-[#7620B1]/5 p-5 ring-1 ring-[#7620B1]/15 space-y-4">
      <h3 class="font-[Outfit] text-sm font-semibold text-[#150D3A]">Account Details</h3>
      <%# ── 1. payout type (starts blank) ── %>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= cf.label :payout_method, "Payout type", class: lbl %>
          <%= cf.select :payout_method,
                        [["Bank", "bank"], ["Mobile money", "mobile_money"]],
                        { include_blank: "Choose payout type" },
                        { required: true, class: field,
                          data: { payout_details_target: "method", action: "change->payout-details#toggle" } } %>
        </div>
      </div>

      <%#
        2a. Bank chosen → bank + account number.
        Keep the target wrappers class-less: a display class like `grid`
        on them would override the `hidden` attribute.
      %>
      <div data-payout-details-target="bank" hidden>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= cf.label :bank, "Bank", class: lbl %>
            <%= cf.select :bank,
                          [["KCB", "kcb"], ["Co-operative Bank", "co-operative-bank"],
                           ["Equity Bank", "equity-bank"], ["Absa Bank", "absa-bank"],
                           ["Standard Chartered", "standard-chartered"],
                           ["CFC Stanbic", "cfc-stanbic"]],
                          { include_blank: "Choose bank" },
                          { required: true, class: field } %>
          </div>
          <div>
            <%= cf.label :account_number, "Account number", class: lbl %>
            <%= cf.text_field :account_number, required: true, inputmode: "numeric",
                              placeholder: "0123456789", class: field %>
          </div>
        </div>
      </div>

      <%#
        2b. Mobile money chosen → provider + number.
        Saves to the same account_number column; the hidden bank one is
        disabled by the controller, so only the visible field is submitted.
      %>
      <div data-payout-details-target="mobileMoney" hidden>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <%= cf.label :mobile_money_provider, "Mobile money provider", class: lbl %>
            <%= cf.select :mobile_money_provider,
                          [["M-Pesa", "mpesa"], ["M-Pesa Paybill", "mpesa-paybill"],
                           ["M-Pesa Till", "mpesa-till"], ["Airtel Money", "airtel-money"],
                           ["Telkom Kenya", "telkom-kenya"]],
                          { include_blank: "Choose provider" },
                          { required: true, class: field } %>
          </div>
          <div>
            <%= cf.label :account_number, "Phone / Till / Paybill number", for: "mobile_money_number", class: lbl %>
            <%= cf.text_field :account_number, id: "mobile_money_number", required: true,
                              inputmode: "numeric", placeholder: "0712 345 678", class: field %>
          </div>
        </div>
      </div>

    </div>


    <%#
      ── what you do ──
      data-collapsed on this card is what hides the toolbar. Set
      collapsed-value to "false" if you'd rather it start open.
    %>
    <div data-controller="editor-toolbar"
         data-editor-toolbar-collapsed-value="true"
         class="space-y-2 rounded-2xl bg-white p-4 ring-1 ring-[#150D3A]/8 sm:p-5
                [&[data-collapsed=true]_[class*=toolbar]]:hidden">

      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
        <%= cf.label :description, "Short description", class: lbl %>

        <button type="button"
                data-action="editor-toolbar#toggle"
                data-editor-toolbar-target="button"
                aria-expanded="false"
                class="flex items-center gap-1 rounded-lg px-2 py-1
                       font-['Inter_Tight'] text-xs font-medium text-[#150D3A]/55
                       transition hover:bg-[#7620B1]/8 hover:text-[#7620B1]
                       focus:outline-none focus-visible:ring-2 focus-visible:ring-[#AB2692]">
          <span data-editor-toolbar-target="label">Formatting</span>
          <svg data-editor-toolbar-target="chevron"
               class="h-3 w-3 transition-transform duration-150"
               viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
      </div>

      <%#
        Lexxy renders its own toolbar and contenteditable inside <lexxy-editor>,
        so we reach them with arbitrary variants on this wrapper rather than
        putting classes on elements we don't render.

        min-h-[9rem] = five lines of text-sm/leading-relaxed plus the padding.
      %>
      <div class="overflow-hidden rounded-xl bg-white ring-1 ring-[#150D3A]/10 transition
                  focus-within:ring-2 focus-within:ring-[#AB2692]

                  [&_lexxy-editor]:block

                  [&_[class*=toolbar]]:flex-wrap [&_[class*=toolbar]]:gap-0.5
                  [&_[class*=toolbar]]:border-b [&_[class*=toolbar]]:border-[#150D3A]/10
                  [&_[class*=toolbar]]:bg-[#150D3A]/[0.025]
                  [&_[class*=toolbar]]:px-1.5 [&_[class*=toolbar]]:py-1

                  [&_[class*=toolbar]_button]:rounded-md [&_[class*=toolbar]_button]:p-1
                  [&_[class*=toolbar]_button]:text-[#150D3A]/60
                  [&_[class*=toolbar]_svg]:h-3.5 [&_[class*=toolbar]_svg]:w-3.5
                  [&_[class*=toolbar]_button:hover]:bg-[#7620B1]/10
                  [&_[class*=toolbar]_button:hover]:text-[#7620B1]
                  [&_button[aria-pressed=true]]:bg-[#7620B1]/10
                  [&_button[aria-pressed=true]]:text-[#7620B1]

                  [&_[contenteditable]]:min-h-[9rem] [&_[contenteditable]]:max-h-80
                  [&_[contenteditable]]:overflow-y-auto
                  [&_[contenteditable]]:px-3.5 [&_[contenteditable]]:py-3
                  [&_[contenteditable]]:font-['Inter_Tight'] [&_[contenteditable]]:text-sm
                  [&_[contenteditable]]:leading-relaxed [&_[contenteditable]]:text-[#150D3A]
                  [&_[contenteditable]]:outline-none

                  [&_[contenteditable]_p]:mb-2.5
                  [&_[contenteditable]_p:last-child]:mb-0
                  [&_[contenteditable]_a]:text-[#AB2692] [&_[contenteditable]_a]:underline
                  [&_[contenteditable]_ul]:list-disc [&_[contenteditable]_ul]:pl-5
                  [&_[contenteditable]_ol]:list-decimal [&_[contenteditable]_ol]:pl-5
                  [&_[contenteditable]_blockquote]:border-l-2
                  [&_[contenteditable]_blockquote]:border-[#7620B1]/30
                  [&_[contenteditable]_blockquote]:pl-3
                  [&_[contenteditable]_blockquote]:text-[#150D3A]/70

                  [&_[class*=placeholder]]:px-3.5 [&_[class*=placeholder]]:py-3
                  [&_[class*=placeholder]]:font-['Inter_Tight']
                  [&_[class*=placeholder]]:text-sm
                  [&_[class*=placeholder]]:text-[#150D3A]/40

                  [&_img]:h-auto [&_img]:max-w-full [&_img]:rounded-lg
                  [&_figure]:my-2 [&_figure]:overflow-hidden [&_figure]:rounded-lg
                  [&_figure]:ring-1 [&_figure]:ring-[#150D3A]/10">
        <%= cf.lexxy_rich_text_area :description,
                                    placeholder: "What kind of events do you run? Add a photo of a past event if you have one." %>
      </div>

      <p class="flex items-start gap-1.5 font-['Inter_Tight'] text-xs text-[#150D3A]/50">
        <svg class="mt-px h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
             stroke-linejoin="round" aria-hidden="true">
          <path d="M21.4 11.05 12.25 20.2a5.5 5.5 0 0 1-7.78-7.78l9.2-9.19a3.67 3.67 0 0 1 5.18 5.18l-9.2 9.2a1.83 1.83 0 0 1-2.59-2.6l8.5-8.48"/>
        </svg>
        Drag an image or PDF straight into the box, or open Formatting to use
        the upload button.
      </p>
    </div>

  <% end %>

  <div class="flex gap-3 pt-1">
    <button type="button" data-action="wizard#back" class="w-1/3 <%= ghost %>">
      Back
    </button>
    <button type="button" data-action="wizard#next"
            class="group flex w-2/3 items-center justify-center gap-2 <%= cta %>">
      Review
      <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
    </button>
  </div>
</div>