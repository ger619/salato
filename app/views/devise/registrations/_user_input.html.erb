<%# The eye button is identical for both fields — its targets resolve against
    whichever data-controller="reveal" wrapper it sits in, so capture it once. %>
<% reveal_button = capture do %>
  <button type="button"
          data-reveal-target="button"
          data-action="reveal#toggle"
          aria-pressed="false"
          aria-label="Show password"
          class="absolute right-1.5 top-1/2 -translate-y-1/2 mr-2 lg:mt-2 mt-6 inline-flex items-center justify-center rounded-lg
                   text-[#150D3A]/45 transition hover:bg-[#7620B1]/8
                   hover:text-[#7620B1] focus:outline-none
                     focus-visible:ring-2 focus-visible:ring-[#AB2692]">

    <svg data-reveal-target="eyeOpen" class="h-[18px] w-[18px] content-center" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="1.9"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>

    <svg data-reveal-target="eyeClosed" class="hidden h-[18px] w-[18px] content-center" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="1.9"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10.6 6.2A9.9 9.9 0 0 1 12 6c6.4 0 10 6 10 6a17 17 0 0 1-3.2 3.9"/>
      <path d="M6.3 8.1A17 17 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 4.2-.9"/>
      <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
      <path d="m3 3 18 18"/>
    </svg>
  </button>
<% end %>

<div data-wizard-target="step"
     data-controller="password-match"
     data-password-match-min-length-value="6"
     class="space-y-5">

  <div>
    <h1 class="font-[Outfit] text-2xl font-bold tracking-tight text-[#150D3A] sm:text-3xl">
      Create your account
    </h1>
    <p class="mt-1.5 font-['Inter_Tight'] text-sm text-[#150D3A]/65">
      Start selling tickets in minutes.
    </p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :first_name, class: lbl %>
      <%= f.text_field :first_name, required: true, class: field %>
    </div>
    <div>
      <%= f.label :last_name, class: lbl %>
      <%= f.text_field :last_name, required: true, class: field %>
    </div>
  </div>

  <div>
    <%= f.label :id_number, "ID Number / Passport", class: lbl %>
    <%= f.text_field :id_number, autocomplete: "off", required: true,
                     maxlength: 20,
                     placeholder: "ID Number / Passport",
                     class: "#{field} h-11 py-0 leading-6" %>
  </div>

  <%# ── ID document — same upload field as the organisation logo ── %>
  <div data-controller="poster-upload"
       data-poster-upload-max-size-value="5242880"
       data-poster-upload-accept-value="image/png,image/jpeg,image/webp">

    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
      <%= f.label :id_photo, "ID photo or passport", class: lbl %>
      <span class="font-['JetBrains_Mono'] text-[10px] uppercase tracking-[0.14em] text-[#150D3A]/40">
        JPG · PNG · WebP — up to 5 MB
      </span>
    </div>

    <p class="mt-1 font-['Inter_Tight'] text-xs text-[#150D3A]/50">
      Used once to verify who you are. It isn't shown on your public page.
    </p>

    <%# The real input stays hidden; the zone below drives it. %>
    <%= f.file_field :id_photo,
                     accept: "image/png,image/jpeg,image/webp",
                     required: true,
                     class: "sr-only",
                     data: { poster_upload_target: "input",
                             action: "change->poster-upload#fileChosen" } %>

    <%# ── empty state ── %>
    <div data-poster-upload-target="zone"
         data-action="click->poster-upload#browse
                      dragenter->poster-upload#dragEnter
                      dragover->poster-upload#dragEnter
                      dragleave->poster-upload#dragLeave
                      drop->poster-upload#drop
                      keydown.enter->poster-upload#browse
                      keydown.space->poster-upload#browse"
         role="button"
         tabindex="0"
         aria-label="Add your ID photo or passport"
         class="group mt-2.5 flex w-full cursor-pointer items-center gap-4 rounded-2xl
                border-2 border-dashed border-[#150D3A]/15 bg-[#F7F4FB] px-4 py-4
                text-left transition duration-200
                hover:border-[#7620B1]/45 hover:bg-[#7620B1]/[0.04]
                focus:outline-none focus-visible:border-[#7620B1]
                focus-visible:ring-4 focus-visible:ring-[#7620B1]/25
                data-[dragging]:border-[#7620B1] data-[dragging]:bg-[#7620B1]/[0.07]">

      <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl
                   bg-gradient-to-br from-[#7620B1] to-[#FC8027] text-white
                   shadow-[0_12px_28px_-14px_rgba(118,32,177,0.95)]
                   transition duration-200 group-hover:-translate-y-0.5
                   motion-reduce:transition-none motion-reduce:group-hover:translate-y-0">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2.5" y="5" width="19" height="14" rx="2.5"/>
          <circle cx="8.5" cy="11" r="2"/>
          <path d="M5 16.2a3.6 3.6 0 0 1 7 0M14.5 10h4M14.5 13.5h4"/>
        </svg>
      </span>

      <span class="min-w-0">
        <span class="block font-[Outfit] text-[15px] font-medium text-[#150D3A]">
          Drop your ID here, or
          <span class="text-[#7620B1] underline decoration-[#7620B1]/30 underline-offset-4">browse</span>
        </span>
        <span class="mt-1 block font-['Inter_Tight'] text-[13px] leading-5 text-[#150D3A]/45">
          Both sides in one photo if your ID has them. Make sure the text is readable.
        </span>
      </span>
    </div>

    <%# ── chosen state ── %>
    <div data-poster-upload-target="preview"
         class="mt-2.5 hidden items-center gap-4 rounded-2xl bg-white p-3 ring-1 ring-[#150D3A]/10">

      <span class="grid h-16 w-16 shrink-0 place-items-center overflow-hidden rounded-xl
                   bg-[#F7F4FB] p-2 ring-1 ring-[#150D3A]/8">
        <%= image_tag "", alt: "",
                      class: "h-full w-full object-contain",
                      data: { poster_upload_target: "image",
                              action: "load->poster-upload#imageLoaded" } %>
      </span>

      <div class="min-w-0 flex-1">
        <p class="truncate font-['Inter_Tight'] text-sm font-medium text-[#150D3A]"
           data-poster-upload-target="filename"></p>
        <p class="mt-0.5 font-['JetBrains_Mono'] text-[11px] text-[#150D3A]/45">
          <span data-poster-upload-target="filesize"></span><span data-poster-upload-target="dimensions"></span>
        </p>
      </div>

      <div class="flex shrink-0 items-center gap-1">
        <button type="button" data-action="poster-upload#browse"
                class="rounded-lg px-2.5 py-1.5 font-['Inter_Tight'] text-xs font-semibold
                       text-[#7620B1] transition hover:bg-[#7620B1]/8
                       focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1]">
          Replace
        </button>
        <button type="button" data-action="poster-upload#remove"
                class="rounded-lg px-2.5 py-1.5 font-['Inter_Tight'] text-xs font-medium
                       text-[#150D3A]/50 transition hover:bg-[#150D3A]/5 hover:text-[#150D3A]
                       focus:outline-none focus-visible:ring-2 focus-visible:ring-[#150D3A]/30">
          Remove
        </button>
      </div>
    </div>

    <p data-poster-upload-target="error"
       class="mt-2 hidden font-['Inter_Tight'] text-xs text-[#FC8027]"></p>
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <%= f.label :email, class: lbl %>
      <%= f.email_field :email, autocomplete: "email", required: true,
                        placeholder: "you@example.com", class: field %>
    </div>
    <div>
      <%= f.label :phone_number, "Phone number", class: lbl %>
      <%= f.telephone_field :phone_number, placeholder: "+254 7XX XXX XXX", class: field %>
    </div>
  </div>

  <%# ── passwords ── %>
  <div class="grid gap-3 sm:grid-cols-2">
    <div data-controller="reveal">
      <%= f.label :password, class: lbl %>
      <div class="relative mt-1.5">
        <%= f.password_field :password,
                             autocomplete: "new-password", required: true, minlength: 6,
                             placeholder: "At least 6 characters",
                             class: "#{field} pr-11",
                             style: "margin-top:0",
                             data: {
                               reveal_target: "input",
                               password_match_target: "password",
                               action: "input->password-match#check"
                             } %>
        <%= reveal_button %>
      </div>
    </div>

    <div data-controller="reveal">
      <%= f.label :password_confirmation, "Confirm password", class: lbl %>
      <div class="relative mt-1.5">
        <%= f.password_field :password_confirmation,
                             autocomplete: "new-password", required: true,
                             placeholder: "Repeat your password",
                             class: "#{field} pr-11",
                             style: "margin-top:0",
                             data: {
                               reveal_target: "input",
                               password_match_target: "confirmation",
                               action: "input->password-match#check"
                             } %>
        <%= reveal_button %>
      </div>
    </div>

    <p data-password-match-target="message"
       role="status" aria-live="polite"
       class="font-['Inter_Tight'] text-xs empty:hidden sm:col-span-2"></p>
  </div>

  <button type="button"
          data-action="wizard#next"
          data-password-match-target="submit"
          class="group mt-2 flex w-full items-center justify-center gap-2 <%= cta %>">
    Continue
    <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
  </button>

  <p class="text-center font-['Inter_Tight'] text-sm text-[#150D3A]/65">
    Already have an account?

    <span data-open-auth="signin" class="cursor-pointer font-bold text-[#AB2692] hover:underline">
    Sign in
  </span>
  </p>
</div>
s