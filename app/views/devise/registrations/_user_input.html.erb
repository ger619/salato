<%# The eye button is identical for both fields — its targets resolve against
    whichever data-controller="reveal" wrapper it sits in, so capture it once. %>
<% reveal_button = capture do %>
  <button type="button"
          data-reveal-target="button"
          data-action="reveal#toggle"
          aria-pressed="false"
          aria-label="Show password"
          class="absolute right-1.5 top-1/2 -translate-y-1/2 mr-2 lg:mt-2 mt-6 inline-flex items-center justify-center rounded-lg
                   text-[#150D3A]/45 transition hover:bg-[#7620B1]/8
                   hover:text-[#7620B1] focus:outline-none
                     focus-visible:ring-2 focus-visible:ring-[#AB2692]">

    <svg data-reveal-target="eyeOpen" class="h-[18px] w-[18px] content-center" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="1.9"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>

    <svg data-reveal-target="eyeClosed" class="hidden h-[18px] w-[18px] content-center" viewBox="0 0 24 24"
         fill="none" stroke="currentColor" stroke-width="1.9"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10.6 6.2A9.9 9.9 0 0 1 12 6c6.4 0 10 6 10 6a17 17 0 0 1-3.2 3.9"/>
      <path d="M6.3 8.1A17 17 0 0 0 2 12s3.6 7 10 7a9.7 9.7 0 0 0 4.2-.9"/>
      <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
      <path d="m3 3 18 18"/>
    </svg>
  </button>
<% end %>

<div data-wizard-target="step"
     data-controller="password-match"
     data-password-match-min-length-value="6"
     class="space-y-5">

  <div>
    <h1 class="font-[Outfit] text-2xl font-bold tracking-tight text-[#150D3A] sm:text-3xl">
      Create your account
    </h1>
    <p class="mt-1.5 font-['Inter_Tight'] text-sm text-[#150D3A]/65">
      Start selling tickets in minutes.
    </p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= f.label :first_name, class: lbl %>
      <%= f.text_field :first_name, required: true, class: field %>
    </div>
    <div>
      <%= f.label :last_name, class: lbl %>
      <%= f.text_field :last_name, required: true, class: field %>
    </div>
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <%= f.label :id_number, "ID Number / Passport", class: lbl %>
      <%= f.text_field :id_number, autocomplete: "off", required: true,
                       placeholder: "ID Number / Passport",
                       class: "#{field} h-11 py-0 leading-6" %>
    </div>

    <div>
      <p class="flex items-center gap-1.5">
        <%= f.label :id_photo, "ID photo or passport", class: lbl %>
        <span class="mt-1.5 font-['Inter_Tight'] text-xs text-[#150D3A]/50">
          JPG, PNG or PDF. Max 5 MB.
        </span>
      </p>
      <%= f.file_field :id_photo,
                       accept: "image/*,application/pdf",
                       required: true,
                       class: "mt-1.5 w-full cursor-pointer rounded-xl bg-white px-3.5 py-2 " \
                         "font-['Inter_Tight'] text-xs text-[#150D3A]/60 " \
                         "ring-1 ring-[#150D3A]/12 transition " \
                         "file:mr-3 file:cursor-pointer file:rounded-lg file:border-0 " \
                         "file:bg-[#7620B1]/10 file:px-3.5 file:py-1.5 " \
                         "file:font-[Outfit] file:text-[13px] file:font-bold file:text-[#7620B1] " \
                         "hover:file:bg-[#7620B1]/20 " \
                         "focus:ring-2 focus:ring-[#AB2692] focus:outline-none" %>
    </div>
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <%= f.label :email, class: lbl %>
      <%= f.email_field :email, autocomplete: "email", required: true,
                        placeholder: "you@example.com", class: field %>
    </div>
    <div>
      <%= f.label :phone_number, "Phone number", class: lbl %>
      <%= f.telephone_field :phone_number, placeholder: "+254 7XX XXX XXX", class: field %>
    </div>
  </div>

  <%# ── passwords ── %>
  <div class="grid gap-3 sm:grid-cols-2">
    <div data-controller="reveal">
      <%= f.label :password, class: lbl %>
      <div class="relative mt-1.5">
        <%= f.password_field :password,
                             autocomplete: "new-password", required: true, minlength: 6,
                             placeholder: "At least 6 characters",
                             class: "#{field} pr-11",
                             style: "margin-top:0",
                             data: {
                               reveal_target: "input",
                               password_match_target: "password",
                               action: "input->password-match#check"
                             } %>
        <%= reveal_button %>
      </div>
    </div>

    <div data-controller="reveal">
      <%= f.label :password_confirmation, "Confirm password", class: lbl %>
      <div class="relative mt-1.5">
        <%= f.password_field :password_confirmation,
                             autocomplete: "new-password", required: true,
                             placeholder: "Repeat your password",
                             class: "#{field} pr-11",
                             style: "margin-top:0",
                             data: {
                               reveal_target: "input",
                               password_match_target: "confirmation",
                               action: "input->password-match#check"
                             } %>
        <%= reveal_button %>
      </div>
    </div>

    <p data-password-match-target="message"
       role="status" aria-live="polite"
       class="font-['Inter_Tight'] text-xs empty:hidden sm:col-span-2"></p>
  </div>

  <button type="button"
          data-action="wizard#next"
          data-password-match-target="submit"
          class="group mt-2 flex w-full items-center justify-center gap-2 <%= cta %>">
    Continue
    <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
  </button>

  <p class="text-center font-['Inter_Tight'] text-sm text-[#150D3A]/65">
    Already have an account?
    <%= link_to "Sign in", new_session_path(resource_name),
                class: "font-bold text-[#AB2692] hover:underline" %>
  </p>
</div>
