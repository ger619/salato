<% unless defined?(user_signed_in?) && user_signed_in? %>
  <div id="authModal" class="fixed inset-0 z-[60] hidden">
    <div class="absolute inset-0 bg-ink/55 backdrop-blur-sm" data-close-auth></div>

    <div class="relative modal-scroll min-h-full flex items-center justify-center p-4">
      <div role="dialog" aria-modal="true" aria-labelledby="authTitle"
           class="w-full max-w-[440px] my-auto rounded-[22px] bg-white shadow-2xl overflow-hidden">

        <div class="grad-bg px-6 sm:px-7 py-5 flex items-center justify-between">
          <span class="mono text-[11px] tracking-[.2em] text-white/95">ORGANISER ACCESS</span>
          <button type="button" data-close-auth class="text-white/85 hover:text-white transition p-1 -m-1" aria-label="Close">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>

        <div class="px-6 sm:px-7 pt-7 pb-8">
          <div class="flex gap-1 p-1 rounded-xl bg-mist" role="tablist">
            <button type="button" role="tab" id="tabSignin" aria-selected="true"  aria-controls="signinPane" class="auth-tab flex-1 py-2.5 rounded-lg text-[15px] font-medium transition">Sign in</button>
            <button type="button" role="tab" id="tabSignup" aria-selected="false" aria-controls="signupPane" class="auth-tab flex-1 py-2.5 rounded-lg text-[15px] font-medium transition">Create account</button>
          </div>

          <h2 id="authTitle" class="mt-7 text-[24px] font-semibold">Welcome back</h2>
          <p id="authSub" class="mt-1.5 text-[15px] text-ink2">Sign in to see tonight's sales.</p>

          <%# ── SIGN IN → Devise SessionsController#create ── %>
          <div id="signinPane" role="tabpanel" aria-labelledby="tabSignin">
            <%= form_with url: user_session_path, method: :post, scope: :user,
                          html: { id: "signinForm", novalidate: true, class: "mt-6 space-y-4",
                                  data: { turbo: false } } do |f| %>
              <div>
                <%= f.label :email, "Email", for: "signin_email", class: "block text-[14px] font-medium mb-2" %>
                <%= f.email_field :email, id: "signin_email", autocomplete: "email", inputmode: "email",
                                  placeholder: "you@example.com",
                                  class: "w-full px-4 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-pink outline-none transition" %>
                <p class="err hidden mt-1.5 text-[13px] text-pink"></p>
              </div>

              <div>
                <div class="flex items-baseline justify-between mb-2">
                  <%= f.label :password, "Password", for: "signin_password", class: "block text-[14px] font-medium" %>
                  <%= link_to "Forgot it?", new_user_password_path, class: "text-[13px] text-magenta hover:underline tap-inline" %>
                </div>
                <%= f.password_field :password, id: "signin_password", autocomplete: "current-password",
                                     placeholder: "••••••••",
                                     class: "w-full px-4 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-pink outline-none transition" %>
                <p class="err hidden mt-1.5 text-[13px] text-pink"></p>
              </div>

              <label class="flex items-center gap-2.5 text-[14px] text-ink2 select-none tap-inline">
                <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-ink/25 text-pink focus:ring-pink" %>
                Keep me signed in
              </label>

              <%= f.submit "Sign in",
                           class: "w-full py-3.5 rounded-xl font-medium text-white grad-bg hover:brightness-110 transition cursor-pointer" %>
            <% end %>
          </div>

          <%# ── SIGN UP → Devise RegistrationsController#create ── %>
          <div id="signupPane" role="tabpanel" aria-labelledby="tabSignup" class="hidden">
            <%= form_with url: user_registration_path, method: :post, scope: :user,
                          html: { id: "signupForm", novalidate: true, class: "mt-6 space-y-4",
                                  data: { turbo: false } } do |f| %>
              <div>
                <%= f.label :name, "Your name", for: "signup_name", class: "block text-[14px] font-medium mb-2" %>
                <%= f.text_field :name, id: "signup_name", autocomplete: "name", placeholder: "Wanjiru Kamau",
                                 class: "w-full px-4 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-pink outline-none transition" %>
                <p class="err hidden mt-1.5 text-[13px] text-pink"></p>
              </div>

              <div>
                <%= f.label :email, "Email", for: "signup_email", class: "block text-[14px] font-medium mb-2" %>
                <%= f.email_field :email, id: "signup_email", autocomplete: "email", inputmode: "email",
                                  placeholder: "you@example.com",
                                  class: "w-full px-4 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-pink outline-none transition" %>
                <p class="err hidden mt-1.5 text-[13px] text-pink"></p>
              </div>

              <div>
                <%= f.label :password, "Password", for: "signup_password", class: "block text-[14px] font-medium mb-2" %>
                <%= f.password_field :password, id: "signup_password", autocomplete: "new-password",
                                     placeholder: "At least 8 characters",
                                     class: "w-full px-4 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-pink outline-none transition" %>
                <p class="err hidden mt-1.5 text-[13px] text-pink"></p>
              </div>

              <div>
                <%= f.label :password_confirmation, "Confirm password", for: "signup_password_confirmation", class: "block text-[14px] font-medium mb-2" %>
                <%= f.password_field :password_confirmation, id: "signup_password_confirmation", autocomplete: "new-password",
                                     placeholder: "Type it once more",
                                     class: "w-full px-4 py-3 rounded-xl bg-white ring-1 ring-ink/12 focus:ring-2 focus:ring-pink outline-none transition" %>
                <p class="err hidden mt-1.5 text-[13px] text-pink"></p>
              </div>

              <%= f.submit "Create account",
                           class: "w-full py-3.5 rounded-xl font-medium text-white grad-bg hover:brightness-110 transition cursor-pointer" %>
            <% end %>
          </div>

          <% if defined?(user_omniauth_authorize_path) %>
            <div class="my-5 flex items-center gap-3 text-[13px] text-ink2/60">
              <span class="h-px flex-1 bg-ink/10"></span>or<span class="h-px flex-1 bg-ink/10"></span>
            </div>

            <%= button_to user_omniauth_authorize_path(:google_oauth2), method: :post,
                          form: { data: { turbo: false } },
                          class: "w-full py-3 rounded-xl font-medium ring-1 ring-ink/15 hover:bg-mist transition flex items-center justify-center gap-2.5" do %>
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.2a5.3 5.3 0 01-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/><path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.3 1.1-3.9 1.1-3 0-5.5-2-6.4-4.7H1.8v3C3.7 21.4 7.6 24 12 24z"/><path fill="#FBBC05" d="M5.6 14.7a7.2 7.2 0 010-4.6v-3H1.8a12 12 0 000 10.6l3.8-3z"/><path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.2 15.1 0 12 0 7.6 0 3.7 2.6 1.8 6.1l3.8 3c.9-2.7 3.4-4.3 6.4-4.3z"/></svg>
              Continue with Google
            <% end %>
          <% end %>

          <p id="authFoot" class="mt-6 text-[13px] text-ink2/75 leading-relaxed">Buying a ticket? You don't need an account — your ticket arrives by email straight after payment.</p>
        </div>
      </div>
    </div>
  </div>
<% end %>
