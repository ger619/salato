<%#
  Organiser sidebar.

  Desktop  — fixed rail, toggles between 16rem and a 4.75rem icon-only strip.
             Content reflows because .app-main is padded by --sidebar-w, so
             collapsing genuinely widens the working area rather than leaving
             an empty gutter.
  Mobile   — off-canvas drawer behind an overlay, opened from the top bar.

  Nav items are either a plain link (:path) or a group (:children). Groups are
  <details> elements, so expanding needs no JavaScript and survives a Turbo
  navigation without any state to restore.

  The collapsed flag lives on <html> (not <body>) so the no-flash snippet in
  the layout head can set it before first paint.
%>

<%# Invitations only exist once devise_invitable is installed, so the child is
    added conditionally rather than raising NoMethodError on every page. %>
<% user_children = [{ label: "View all users", path: users_path }] %>
<% if defined?(new_user_invitation_path) %>
  <% user_children << { label: "Invite a user", path: new_user_invitation_path } %>
<% end %>

<% nav_items = [
  { label: "Dashboard", icon: :dashboard,
    path: (defined?(dashboard_index_path) ? dashboard_index_path : "#"),
    active: controller_name == "dashboard" },

  { label: "Events", icon: :events,
    path: organiser_events_path,
    active: controller_name == "events" },

  { label: "Orders", icon: :orders,
    path: "#", active: controller_name == "orders" },

  { label: "Tickets", icon: :tickets,
    path: (defined?(tickets_path) ? tickets_path : "#"),
    active: controller_name == "tickets" },

  { label: "Gate scanner", icon: :scanner,
    path: verify_path,
    active: controller_name == "ticket_verifications" },

  { label: "Users", icon: :users,
    active: %w[users invitations].include?(controller_name),
    children: user_children },

  { label: "Client", icon: :scanner,
    path: clients_path,
    active: controller_name == "clients" },

  { label: "Settings", icon: :settings,
    path: "#", active: controller_name == "settings" }
] %>

<style>
    /* ── The one number everything keys off ───────────────────────────── */
    :root {
        --rail-open: 16rem;
        --rail-shut: 4.75rem;
        --sidebar-w: var(--rail-open);
        --rail-ease: cubic-bezier(.2,.7,.3,1);
    }

    html[data-sidebar="collapsed"] { --sidebar-w: var(--rail-shut); }

    /* Below lg the rail is a drawer floating over the page, so content is
       never offset — regardless of the collapsed flag. */
    @media (max-width: 1023.98px) {
        :root,
        html[data-sidebar="collapsed"] { --sidebar-w: 0rem; }
    }

    /* ── Content area ─────────────────────────────────────────────────── */
    .app-main {
        padding-inline-start: var(--sidebar-w);
        transition: padding-inline-start .28s var(--rail-ease);
        min-width: 0;
    }

    /* Generous ceiling so collapsing buys usable width instead of just wider
       margins. Lower the max-width if you prefer a tighter measure. */
    .app-inner {
        max-width: 1600px;
        margin-inline: auto;
        min-width: 0;
        padding-inline: 1rem;
        padding-block: 1.25rem;
    }
    @media (min-width: 640px)  { .app-inner { padding-inline: 1.5rem; padding-block: 1.75rem; } }
    @media (min-width: 1280px) { .app-inner { padding-inline: 2rem;   padding-block: 2rem; } }

    /* Grid children default to min-width:auto and refuse to shrink below their
       content — which is what makes wide tables and charts blow past the rail. */
    .app-main :where(.grid) > * { min-width: 0; }

    /* ── Collapsed rail presentation (desktop only) ───────────────────── */
    @media (min-width: 1024px) {
        html[data-sidebar="collapsed"] .rail-label,
        html[data-sidebar="collapsed"] .rail-badge,
        html[data-sidebar="collapsed"] .rail-wordmark { display: none; }

        html[data-sidebar="collapsed"] .rail-item {
            justify-content: center;
            padding-inline: 0;
        }
        html[data-sidebar="collapsed"] .rail-mark  { display: block; }
        html[data-sidebar="collapsed"] .rail-brand { justify-content: center; }
        html[data-sidebar="collapsed"] .rail-item:hover .rail-tip,
        html[data-sidebar="collapsed"] .rail-item:focus-visible .rail-tip {
            opacity: 1; transform: translateX(0);
        }

        /* A 4.75rem strip has no room for a submenu. The summary stays
           clickable — the script below reopens the rail instead. */
        html[data-sidebar="collapsed"] .rail-group > ul,
        html[data-sidebar="collapsed"] .rail-chevron { display: none; }
    }
    .rail-mark { display: none; }

    .rail-tip {
        position: absolute; left: calc(100% + 10px); white-space: nowrap;
        background: #150D3A; color: #fff; font-size: 13px; padding: 6px 10px;
        border-radius: 8px; box-shadow: 0 10px 30px -12px rgba(0,0,0,.6);
        opacity: 0; transform: translateX(-6px);
        transition: opacity .18s ease, transform .18s ease;
        pointer-events: none; z-index: 60;
    }

    /* ── Nav groups ───────────────────────────────────────────────────── */
    .rail-group > summary { list-style: none; cursor: pointer; }
    .rail-group > summary::-webkit-details-marker { display: none; }
    .rail-chevron { transition: transform .18s ease; }
    .rail-group[open] .rail-chevron { transform: rotate(90deg); }

    /* Active item: gradient spine on the leading edge. A group carries it on
       its summary, since aria-current isn't valid on a non-link. */
    .rail-item[aria-current="page"]::before,
    .rail-group > summary[data-active="true"]::before {
        content: ""; position: absolute; inset-inline-start: 0; top: 8px; bottom: 8px;
        width: 3px; border-radius: 0 3px 3px 0; background: var(--grad);
    }

    @media (prefers-reduced-motion: reduce) {
        .app-main, .rail-tip, .rail-chevron, #sidebar, #sidebarOverlay { transition: none !important; }
    }
</style>

<%# ══════════════ MOBILE TOP BAR ══════════════ %>
<div class="lg:hidden sticky top-0 z-30 flex items-center gap-3 bg-ink text-white px-4 py-3 border-b border-white/10">
  <button type="button" data-sidebar-open
          class="p-2 -ms-2 rounded-lg hover:bg-white/10 transition"
          aria-controls="sidebar" aria-expanded="false" aria-label="Open menu">
    <%= render "shared/sidebar_icon", name: :menu, class_name: "w-6 h-6" %>
  </button>

  <%= link_to (defined?(dashboard_index_path) ? dashboard_index_path : root_path), class: "shrink-0" do %>
    <%= image_tag "salato_logo/salato-logo-horizontal-on-dark.png", alt: "Salato", class: "h-7 w-auto" %>
  <% end %>
</div>

<%# ══════════════ OVERLAY (mobile only) ══════════════ %>
<div id="sidebarOverlay" data-sidebar-close
     class="lg:hidden fixed inset-0 z-40 bg-ink/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
     aria-hidden="true"></div>

<%# ══════════════ SIDEBAR ══════════════ %>
<aside id="sidebar" aria-label="Organiser navigation"
       class="fixed top-0 left-0 z-50 h-dvh w-64 lg:w-[var(--sidebar-w)]
              -translate-x-full lg:translate-x-0
              transition-transform duration-300 ease-[cubic-bezier(.2,.7,.3,1)]
              lg:transition-[width] lg:duration-300 lg:ease-[cubic-bezier(.2,.7,.3,1)]">

  <div class="h-full flex flex-col bg-ink text-white border-e border-white/10 overflow-y-auto overflow-x-hidden overscroll-contain">

    <%# ── Brand ── %>
    <div class="rail-brand flex items-center justify-between gap-2 px-4 py-4 border-b border-white/10">
      <%= link_to (defined?(dashboard_index_path) ? dashboard_index_path : root_path),
                  class: "shrink-0 min-w-0", "aria-label": "Salato" do %>
        <%= image_tag "salato_logo/salato-logo-horizontal-on-dark.png", alt: "Salato",
                      class: "rail-wordmark h-8 w-auto max-w-none" %>
        <%= image_tag "salato_logo/salato-icon-192.png", alt: "Salato",
                      class: "rail-mark h-8 w-8 mx-auto" %>
      <% end %>

      <%# Collapse control — hidden while collapsed so the rail stays clean %>
      <button type="button" data-sidebar-collapse
              class="rail-label hidden lg:grid place-items-center w-8 h-8 shrink-0 rounded-lg text-white/60 hover:text-white hover:bg-white/10 transition"
              aria-label="Collapse sidebar">
        <%= render "shared/sidebar_icon", name: :collapse, class_name: "w-4 h-4" %>
      </button>

      <%# Mobile close %>
      <button type="button" data-sidebar-close
              class="lg:hidden grid place-items-center w-9 h-9 shrink-0 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition"
              aria-label="Close menu">
        <%= render "shared/sidebar_icon", name: :close, class_name: "w-5 h-5" %>
      </button>
    </div>

    <%# Expand handle — only visible while collapsed %>
    <button type="button" data-sidebar-collapse
            class="rail-mark w-full py-2 text-white/45 hover:text-white hover:bg-white/[.07] transition"
            aria-label="Expand sidebar">
      <svg class="w-4 h-4 mx-auto rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 6l-6 6 6 6"/>
      </svg>
    </button>

    <%# ── Nav ── %>
    <nav class="flex-1 px-3 py-4">
      <ul class="space-y-1">
        <% nav_items.each do |item| %>
          <li>
            <% if item[:children].present? %>

              <%# ── Group ── %>
              <details class="rail-group" <%= "open" if item[:active] %>>
                <summary data-active="<%= item[:active] %>"
                         class="rail-item group relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-[15px] transition
                                <%= item[:active] ? 'bg-white/10 text-white font-medium' : 'text-white/70 hover:text-white hover:bg-white/[.07]' %>">
                  <%= render "shared/sidebar_icon", name: item[:icon],
                             class_name: "w-5 h-5 shrink-0 #{item[:active] ? 'text-ember' : 'text-white/55 group-hover:text-white/90'} transition" %>

                  <span class="rail-label flex-1 whitespace-nowrap"><%= item[:label] %></span>

                  <svg class="rail-chevron rail-label w-3.5 h-3.5 shrink-0 text-white/40"
                       viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 6l6 6-6 6"/>
                  </svg>

                  <span class="rail-tip hidden lg:block"><%= item[:label] %></span>
                </summary>

                <ul class="mt-1 ms-4 ps-4 border-s border-white/10 space-y-0.5">
                  <% item[:children].each do |child| %>
                    <% child_active = current_page?(child[:path]) %>
                    <li>
                      <%= link_to child[:label], child[:path],
                                  class: "block px-3 py-2 rounded-lg text-[14px] whitespace-nowrap transition
                                          #{child_active ? 'text-white bg-white/10 font-medium' : 'text-white/60 hover:text-white hover:bg-white/[.07]'}",
                                  aria: { current: (child_active ? "page" : nil) } %>
                    </li>
                  <% end %>
                </ul>
              </details>

            <% else %>

              <%# ── Plain link ── %>
              <%= link_to item[:path],
                          class: "rail-item group relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-[15px] transition
                            #{item[:active] ? 'bg-white/10 text-white font-medium' : 'text-white/70 hover:text-white hover:bg-white/[.07]'}",
                          aria: { current: (item[:active] ? "page" : nil) } do %>
                <%= render "shared/sidebar_icon", name: item[:icon],
                           class_name: "w-5 h-5 shrink-0 #{item[:active] ? 'text-ember' : 'text-white/55 group-hover:text-white/90'} transition" %>
                <span class="rail-label flex-1 whitespace-nowrap"><%= item[:label] %></span>
                <span class="rail-tip hidden lg:block"><%= item[:label] %></span>
              <% end %>

            <% end %>
          </li>
        <% end %>
      </ul>

      <%# Counted item — only renders when a number is passed in %>
      <% if local_assigns[:pending_payouts].to_i.positive? %>
        <div class="mt-6 pt-4 border-t border-white/10">
          <a href="#" class="rail-item group relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-[15px] text-white/70 hover:text-white hover:bg-white/[.07] transition">
            <%= render "shared/sidebar_icon", name: :orders, class_name: "w-5 h-5 shrink-0 text-white/55 group-hover:text-white/90 transition" %>
            <span class="rail-label flex-1 whitespace-nowrap">Payouts</span>
            <span class="rail-badge grad-bg text-white text-[11px] font-medium px-2 py-0.5 rounded-full"><%= pending_payouts %></span>
            <span class="rail-tip hidden lg:block">Payouts</span>
          </a>
        </div>
      <% end %>
    </nav>

    <%# ── Account ── %>
    <div class="px-3 py-4 border-t border-white/10">
      <% if defined?(current_user) && current_user %>
        <div class="rail-item flex items-center gap-3 px-3 py-2 mb-1">
          <span class="grid place-items-center w-8 h-8 shrink-0 rounded-full grad-bg text-[13px] font-semibold">
            <%= (current_user.try(:first_name).presence || current_user.email).to_s.first&.upcase %>
          </span>
          <span class="rail-label min-w-0">
            <span class="block text-[13px] text-white/90 truncate">
              <%= current_user.try(:full_name).presence || current_user.email %>
            </span>
            <span class="block text-[11px] text-white/45">
              <%= current_user.roles.first&.name&.humanize || "Organiser" %>
            </span>
          </span>
        </div>
      <% end %>

      <%= button_to destroy_user_session_path, method: :delete,
                    form: { data: { turbo: false } },
                    data: { turbo_confirm: "Sign out of Salato?" },
                    class: "rail-item group relative flex w-full items-center gap-3 px-3 py-2.5 rounded-xl text-[15px] text-white/70 hover:text-white hover:bg-flare/20 transition" do %>
        <%= render "shared/sidebar_icon", name: :signout, class_name: "w-5 h-5 shrink-0 text-white/55 group-hover:text-flare transition" %>
        <span class="rail-label flex-1 text-left whitespace-nowrap">Sign out</span>
        <span class="rail-tip hidden lg:block">Sign out</span>
      <% end %>
    </div>
  </div>
</aside>

<script>
    /* Bound once at parse time, delegated off document, each click marked —
       so a duplicate copy of this script can't double-toggle anything. */
    (function(){
        if(window.__salatoSidebarBound) return;
        window.__salatoSidebarBound = true;

        const RAIL_KEY = 'salato:sidebar';
        const root = document.documentElement;
        const el = (s)=>document.querySelector(s);

        const openDrawer = ()=>{
            const bar = el('#sidebar'), veil = el('#sidebarOverlay');
            if(!bar) return;
            bar.classList.remove('-translate-x-full');
            veil?.classList.remove('opacity-0','pointer-events-none');
            document.body.style.overflow = 'hidden';
            el('[data-sidebar-open]')?.setAttribute('aria-expanded','true');
        };

        const closeDrawer = ()=>{
            const bar = el('#sidebar'), veil = el('#sidebarOverlay');
            if(!bar) return;
            bar.classList.add('-translate-x-full');
            veil?.classList.add('opacity-0','pointer-events-none');
            document.body.style.overflow = '';
            el('[data-sidebar-open]')?.setAttribute('aria-expanded','false');
        };

        const setCollapsed = (collapsed)=>{
            root.dataset.sidebar = collapsed ? 'collapsed' : 'expanded';
            try { localStorage.setItem(RAIL_KEY, collapsed ? '1' : '0'); } catch(_){}

            /* Anything that measured its own width — a canvas, a sticky table
               header, a future charting library — gets a chance to re-measure
               once the rail has finished moving. */
            setTimeout(()=>window.dispatchEvent(new Event('resize')), 320);
        };

        document.addEventListener('click', (e)=>{
            if(e.__salatoSidebar) return;
            e.__salatoSidebar = true;

            if(e.target.closest('[data-sidebar-open]'))     return openDrawer();
            if(e.target.closest('[data-sidebar-close]'))    return closeDrawer();
            if(e.target.closest('[data-sidebar-collapse]')) {
                return setCollapsed(root.dataset.sidebar !== 'collapsed');
            }

            /* Opening a submenu inside a 4.75rem strip would reveal nothing,
               so the click reopens the rail and expands the group instead. */
            const summary = e.target.closest('.rail-group > summary');
            if(summary && window.innerWidth >= 1024 && root.dataset.sidebar === 'collapsed'){
                e.preventDefault();
                setCollapsed(false);
                summary.parentElement.open = true;
                return;
            }

            /* Only one group open at a time, so the rail never grows a scrollbar. */
            if(summary && !summary.parentElement.open){
                document.querySelectorAll('.rail-group[open]').forEach((d)=>{
                    if(d !== summary.parentElement) d.open = false;
                });
            }

            if(window.innerWidth < 1024 && e.target.closest('#sidebar a')) closeDrawer();
        });

        document.addEventListener('keydown', (e)=>{
            if(e.key === 'Escape') closeDrawer();
            /* "[" toggles the rail — useful when you live in this screen */
            if(e.key === '[' && !/input|textarea|select/i.test(e.target.tagName)){
                setCollapsed(root.dataset.sidebar !== 'collapsed');
            }
        });

        window.addEventListener('resize', ()=>{
            if(window.innerWidth >= 1024) closeDrawer();
        }, {passive:true});

        const restore = ()=>{
            let saved = '0';
            try { saved = localStorage.getItem(RAIL_KEY) || '0'; } catch(_){}
            root.dataset.sidebar = saved === '1' ? 'collapsed' : 'expanded';
            closeDrawer();
        };

        restore();
        document.addEventListener('turbo:load', restore);
    })();
</script>
