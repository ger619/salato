<%#
  Organiser sidebar.

  Desktop  — fixed rail, toggles between 16rem and a 4.75rem icon-only strip.
             The collapsed state is remembered in localStorage.
  Mobile   — off-canvas drawer behind an overlay, opened from the top bar.

  Page content sits inside <div class="app-main"> which is offset by the
  --sidebar-w custom property, so it reflows when the rail collapses.
%>

<% nav_items = [
     { label: "Dashboard", icon: :dashboard,
       path: (defined?(dashboard_index_path) ? dashboard_index_path : "#"),
       active: controller_name == "dashboard" },

     { label: "Events", icon: :events,
       path: (defined?(events_path) ? events_path : "#"),
       active: controller_name == "events" },

     { label: "Orders", icon: :orders,
       path: "#", active: controller_name == "orders" },

     { label: "Tickets", icon: :tickets,
       path: (defined?(tickets_path) ? tickets_path : "#"),
       active: controller_name == "tickets" },

     { label: "Gate scanner", icon: :scanner,
       path: "#", active: controller_name == "ticket_verifications" },

     { label: "Customers", icon: :users,
       path: (defined?(users_path) ? users_path : "#"),
       active: controller_name == "users" },

     { label: "Settings", icon: :settings,
       path: "#", active: controller_name == "settings" }
   ] %>

<style>
  :root { --sidebar-w: 16rem; }
  body[data-sidebar="collapsed"] { --sidebar-w: 4.75rem; }

  .app-main {
    padding-left: var(--sidebar-w);
    transition: padding-left .28s cubic-bezier(.2,.7,.3,1);
  }

  /* Below lg the rail is a drawer, so content never gets offset. */
  @media (max-width: 1023.98px) {
    .app-main { padding-left: 0; }
  }

  /* Hide labels when collapsed, but only on desktop — the mobile drawer
     always shows them at full width. */
  @media (min-width: 1024px) {
    body[data-sidebar="collapsed"] .rail-label,
    body[data-sidebar="collapsed"] .rail-badge,
    body[data-sidebar="collapsed"] .rail-wordmark { display: none; }
    body[data-sidebar="collapsed"] .rail-item { justify-content: center; padding-left: 0; padding-right: 0; }
    body[data-sidebar="collapsed"] .rail-mark { display: block; }
    body[data-sidebar="collapsed"] .rail-collapse svg { transform: rotate(180deg); }
    body[data-sidebar="collapsed"] .rail-item:hover .rail-tip { opacity: 1; transform: translateX(0); }
  }
  .rail-mark { display: none; }

  .rail-tip {
    position: absolute; left: calc(100% + 10px); white-space: nowrap;
    background: #150D3A; color: #fff; font-size: 13px; padding: 6px 10px;
    border-radius: 8px; box-shadow: 0 10px 30px -12px rgba(0,0,0,.6);
    opacity: 0; transform: translateX(-6px); transition: opacity .18s ease, transform .18s ease;
    pointer-events: none; z-index: 60;
  }

  /* Active item: gradient spine on the leading edge. */
  .rail-item[aria-current="page"]::before {
    content: ""; position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px;
    border-radius: 0 3px 3px 0; background: var(--grad);
  }
  body[data-sidebar="collapsed"] .rail-item[aria-current="page"]::before { top: 6px; bottom: 6px; }

  @media (prefers-reduced-motion: reduce) {
    .app-main, .rail-tip, #sidebar, #sidebarOverlay { transition: none !important; }
  }
</style>

<%# ══════════════ MOBILE TOP BAR ══════════════ %>
<div class="lg:hidden sticky top-0 z-30 flex items-center gap-3 bg-ink text-white px-4 py-3 border-b border-white/10">
  <button type="button" data-sidebar-open
          class="p-2 -ms-2 rounded-lg hover:bg-white/10 transition"
          aria-controls="sidebar" aria-expanded="false" aria-label="Open menu">
    <%= render "shared/sidebar_icon", name: :menu, class_name: "w-6 h-6" %>
  </button>

  <%= link_to (defined?(dashboard_index_path) ? dashboard_index_path : root_path), class: "shrink-0" do %>
    <%= image_tag "salato_logo/salato-logo-horizontal-on-dark.png", alt: "Salato", class: "h-7 w-auto" %>
  <% end %>
</div>

<%# ══════════════ OVERLAY (mobile only) ══════════════ %>
<div id="sidebarOverlay" data-sidebar-close
     class="lg:hidden fixed inset-0 z-40 bg-ink/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
     aria-hidden="true"></div>

<%# ══════════════ SIDEBAR ══════════════ %>
<aside id="sidebar" aria-label="Organiser navigation"
       class="fixed top-0 left-0 z-50 h-dvh w-64 lg:w-[var(--sidebar-w)]
              -translate-x-full lg:translate-x-0
              transition-transform duration-300 ease-[cubic-bezier(.2,.7,.3,1)]
              lg:transition-[width] lg:duration-300">

  <div class="h-full flex flex-col bg-ink text-white border-e border-white/10 overflow-y-auto overscroll-contain">

    <%# ── Brand ── %>
    <div class="flex items-center justify-between gap-2 px-4 py-4 border-b border-white/10">
      <%= link_to (defined?(dashboard_index_path) ? dashboard_index_path : root_path),
                  class: "shrink-0 min-w-0", "aria-label": "Salato" do %>
        <%= image_tag "salato_logo/salato-logo-horizontal-on-dark.png", alt: "Salato",
              class: "rail-wordmark h-8 w-auto" %>
        <%= image_tag "salato_logo/salato-icon-192.png", alt: "Salato",
              class: "rail-mark h-8 w-8 mx-auto" %>
      <% end %>

      <%# Desktop collapse toggle %>
      <button type="button" data-sidebar-collapse
              class="rail-collapse hidden lg:grid place-items-center w-8 h-8 shrink-0 rounded-lg text-white/60 hover:text-white hover:bg-white/10 transition"
              aria-label="Collapse sidebar">
        <%= render "shared/sidebar_icon", name: :collapse, class_name: "w-4 h-4 transition-transform" %>
      </button>

      <%# Mobile close %>
      <button type="button" data-sidebar-close
              class="lg:hidden grid place-items-center w-9 h-9 shrink-0 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition"
              aria-label="Close menu">
        <%= render "shared/sidebar_icon", name: :close, class_name: "w-5 h-5" %>
      </button>
    </div>

    <%# ── Nav ── %>
    <nav class="flex-1 px-3 py-4">
      <ul class="space-y-1">
        <% nav_items.each do |item| %>
          <li>
            <%= link_to item[:path],
                  class: "rail-item group relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-[15px] transition
                          #{item[:active] ? 'bg-white/10 text-white font-medium' : 'text-white/70 hover:text-white hover:bg-white/[.07]'}",
                  aria: { current: (item[:active] ? "page" : nil) } do %>
              <%= render "shared/sidebar_icon", name: item[:icon],
                    class_name: "w-5 h-5 shrink-0 #{item[:active] ? 'text-ember' : 'text-white/55 group-hover:text-white/90'} transition" %>
              <span class="rail-label flex-1 whitespace-nowrap"><%= item[:label] %></span>
              <span class="rail-tip lg:block hidden"><%= item[:label] %></span>
            <% end %>
          </li>
        <% end %>
      </ul>

      <%# Example of a counted item — wire the number to a real scope %>
      <% if local_assigns[:pending_payouts].to_i.positive? %>
        <div class="mt-6 pt-4 border-t border-white/10">
          <a href="#" class="rail-item group relative flex items-center gap-3 px-3 py-2.5 rounded-xl text-[15px] text-white/70 hover:text-white hover:bg-white/[.07] transition">
            <%= render "shared/sidebar_icon", name: :orders, class_name: "w-5 h-5 shrink-0 text-white/55 group-hover:text-white/90 transition" %>
            <span class="rail-label flex-1 whitespace-nowrap">Payouts</span>
            <span class="rail-badge grad-bg text-white text-[11px] font-medium px-2 py-0.5 rounded-full"><%= pending_payouts %></span>
            <span class="rail-tip lg:block hidden">Payouts</span>
          </a>
        </div>
      <% end %>
    </nav>

    <%# ── Account ── %>
    <div class="px-3 py-4 border-t border-white/10">
      <% if defined?(current_user) && current_user %>
        <div class="rail-item flex items-center gap-3 px-3 py-2 mb-1">
          <span class="grid place-items-center w-8 h-8 shrink-0 rounded-full grad-bg text-[13px] font-semibold">
            <%= current_user.email.to_s.first&.upcase %>
          </span>
          <span class="rail-label min-w-0">
            <span class="block text-[13px] text-white/90 truncate"><%= current_user.email %></span>
            <span class="block text-[11px] text-white/45">Organiser</span>
          </span>
        </div>
      <% end %>

      <%= button_to destroy_user_session_path, method: :delete,
            form: { data: { turbo: false } },
            data: { turbo_confirm: "Sign out of Salato?" },
            class: "rail-item group relative flex w-full items-center gap-3 px-3 py-2.5 rounded-xl text-[15px] text-white/70 hover:text-white hover:bg-flare/20 transition" do %>
        <%= render "shared/sidebar_icon", name: :signout, class_name: "w-5 h-5 shrink-0 text-white/55 group-hover:text-flare transition" %>
        <span class="rail-label flex-1 text-left whitespace-nowrap">Sign out</span>
        <span class="rail-tip lg:block hidden">Sign out</span>
      <% end %>
    </div>
  </div>
</aside>

<script>
    /* Same de-dup pattern as the main nav: bound once at parse time,
       delegated off document, and each click marked so a duplicate copy
       of this script can't double-toggle. */
    (function(){
        if(window.__salatoSidebarBound) return;
        window.__salatoSidebarBound = true;

        const RAIL_KEY = 'salato:sidebar';
        const el = (s)=>document.querySelector(s);

        const openDrawer = ()=>{
            const bar = el('#sidebar'), veil = el('#sidebarOverlay');
            if(!bar) return;
            bar.classList.remove('-translate-x-full');
            veil?.classList.remove('opacity-0','pointer-events-none');
            document.body.style.overflow = 'hidden';
            document.querySelector('[data-sidebar-open]')?.setAttribute('aria-expanded','true');
        };

        const closeDrawer = ()=>{
            const bar = el('#sidebar'), veil = el('#sidebarOverlay');
            if(!bar) return;
            bar.classList.add('-translate-x-full');
            veil?.classList.add('opacity-0','pointer-events-none');
            document.body.style.overflow = '';
            document.querySelector('[data-sidebar-open]')?.setAttribute('aria-expanded','false');
        };

        const setCollapsed = (collapsed)=>{
            document.body.dataset.sidebar = collapsed ? 'collapsed' : 'expanded';
            try { localStorage.setItem(RAIL_KEY, collapsed ? '1' : '0'); } catch(_){}
            const btn = document.querySelector('[data-sidebar-collapse]');
            btn?.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
        };

        document.addEventListener('click', (e)=>{
            if(e.__salatoSidebar) return;
            e.__salatoSidebar = true;

            if(e.target.closest('[data-sidebar-open]'))     return openDrawer();
            if(e.target.closest('[data-sidebar-close]'))    return closeDrawer();
            if(e.target.closest('[data-sidebar-collapse]')) {
                return setCollapsed(document.body.dataset.sidebar !== 'collapsed');
            }

            /* tapping a nav link inside the mobile drawer dismisses it */
            if(window.innerWidth < 1024 && e.target.closest('#sidebar a')) closeDrawer();
        });

        document.addEventListener('keydown', (e)=>{
            if(e.key === 'Escape') closeDrawer();
        });

        window.addEventListener('resize', ()=>{
            if(window.innerWidth >= 1024) closeDrawer();
        }, {passive:true});

        /* Restore the collapsed preference before first paint where possible. */
        const restore = ()=>{
            let saved = '0';
            try { saved = localStorage.getItem(RAIL_KEY) || '0'; } catch(_){}
            setCollapsed(saved === '1');
            closeDrawer();
        };

        restore();
        document.addEventListener('turbo:load', restore);
    })();
</script>
