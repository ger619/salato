<header id="nav" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <div class="max-w-shell mx-auto px-5 lg:px-8">
    <nav class="mt-3 lg:mt-4 flex items-center justify-between rounded-2xl bg-white/85 backdrop-blur-xl ring-1 ring-ink/8 shadow-[0_8px_30px_-12px_rgba(21,13,58,.18)] pl-4 pr-3 py-2.5">
      <%= link_to root_path, class: "shrink-0", "aria-label": "Salato home" do %>
        <%= image_tag "salato_logo/salato-logo-horizontal.png", alt: "Salato", class: "h-8 lg:h-9 w-auto" %>
      <% end %>

      <ul class="hidden lg:flex items-center gap-8 text-[15px] font-medium text-ink2">
        <li><%= link_to "Home",         nav_anchor("hero"),    class: "navlink hover:text-ink transition" %></li>
        <li><%= link_to "About us",     nav_anchor("about"),   class: "navlink hover:text-ink transition" %></li>
        <li><%= link_to "How it works", nav_anchor("how"),     class: "navlink hover:text-ink transition" %></li>
        <li><%= link_to "Pricing",      nav_anchor("pricing"), class: "navlink hover:text-ink transition" %></li>
        <li><%= link_to "Contact",      nav_anchor("contact"), class: "navlink hover:text-ink transition" %></li>
      </ul>

      <div class="flex items-center gap-2">
        <% if defined?(user_signed_in?) && user_signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "hidden sm:inline-flex items-center px-4 py-2 rounded-xl text-[15px] font-medium text-white grad-bg hover:brightness-110 transition shadow-[0_6px_20px_-8px_rgba(225,55,101,.9)]" %>
        <% else %>
          <button type="button" data-open-auth="signin" class="hidden sm:inline-flex items-center px-4 py-2 rounded-xl text-[15px] font-medium text-ink hover:bg-ink/5 transition">Sign in</button>
          <%= link_to "Start selling", nav_anchor("pricing"), class: "hidden sm:inline-flex items-center px-4 py-2 rounded-xl text-[15px] font-medium text-white grad-bg hover:brightness-110 transition shadow-[0_6px_20px_-8px_rgba(225,55,101,.9)]" %>
        <% end %>

        <button type="button" id="menuBtn" class="lg:hidden p-2 rounded-lg hover:bg-ink/5 transition" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </nav>

    <div id="mobileMenu" class="lg:hidden hidden mt-2 rounded-2xl bg-white ring-1 ring-ink/10 shadow-xl p-4">
      <ul class="flex flex-col gap-1 text-[16px] font-medium">
        <li><%= link_to "Home",         nav_anchor("hero"),    class: "block px-3 py-2.5 rounded-lg hover:bg-mist" %></li>
        <li><%= link_to "About us",     nav_anchor("about"),   class: "block px-3 py-2.5 rounded-lg hover:bg-mist" %></li>
        <li><%= link_to "How it works", nav_anchor("how"),     class: "block px-3 py-2.5 rounded-lg hover:bg-mist" %></li>
        <li><%= link_to "Pricing",      nav_anchor("pricing"), class: "block px-3 py-2.5 rounded-lg hover:bg-mist" %></li>
        <li><%= link_to "Contact",      nav_anchor("contact"), class: "block px-3 py-2.5 rounded-lg hover:bg-mist" %></li>
      </ul>
      <div class="mt-3 pt-3 border-t border-ink/10 flex gap-2">
        <button type="button" data-open-auth="signin" class="flex-1 px-4 py-2.5 rounded-xl font-medium ring-1 ring-ink/15">Sign in</button>
        <%= link_to "Start selling", nav_anchor("pricing"), class: "flex-1 text-center px-4 py-2.5 rounded-xl font-medium text-white grad-bg" %>
      </div>
    </div>
  </div>
</header>
