<%# Icon set for the sidebar. locals: name, class_name (optional) %>
<% klass = local_assigns[:class_name] || "w-5 h-5 shrink-0" %>
<svg class="<%= klass %>" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
     width="24" height="24" fill="none" viewBox="0 0 24 24"
     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  <% case name.to_sym %>
  <% when :dashboard %>
    <path d="M10 6.025A7.5 7.5 0 1 0 17.975 14H10V6.025Z"/>
    <path d="M13.5 3c-.169 0-.334.014-.5.025V11h7.975c.011-.166.025-.331.025-.5A7.5 7.5 0 0 0 13.5 3Z"/>
  <% when :events %>
    <path d="M15 5v14M9 5v14M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/>
  <% when :tickets %>
    <path d="M3 9V7a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v2a2 2 0 0 0 0 4v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2a2 2 0 0 0 0-4Z"/>
    <path d="M14 6v2M14 11v2M14 16v2"/>
  <% when :orders %>
    <path d="M4 13h3.44a1 1 0 0 1 .9.6 3.98 3.98 0 0 0 7.31 0 .99.99 0 0 1 .91-.6H20M4 13v6a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-6M4 13l2-9h12l2 9M9 7h6m-7 3h8"/>
  <% when :scanner %>
    <path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/>
    <path d="M4 12h16"/>
  <% when :users %>
    <path d="M16 19h4a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-2m-2.24-4a3 3 0 1 0 0-4M3 18v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Zm8-10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
  <% when :settings %>
    <path d="M9.6 3.8a1 1 0 0 1 1-.8h2.8a1 1 0 0 1 1 .8l.3 1.5a7 7 0 0 1 1.4.8l1.4-.5a1 1 0 0 1 1.2.4l1.4 2.4a1 1 0 0 1-.2 1.3l-1.1 1a7 7 0 0 1 0 1.6l1.1 1a1 1 0 0 1 .2 1.3l-1.4 2.4a1 1 0 0 1-1.2.4l-1.4-.5a7 7 0 0 1-1.4.8l-.3 1.5a1 1 0 0 1-1 .8h-2.8a1 1 0 0 1-1-.8l-.3-1.5a7 7 0 0 1-1.4-.8l-1.4.5a1 1 0 0 1-1.2-.4l-1.4-2.4a1 1 0 0 1 .2-1.3l1.1-1a7 7 0 0 1 0-1.6l-1.1-1a1 1 0 0 1-.2-1.3l1.4-2.4a1 1 0 0 1 1.2-.4l1.4.5a7 7 0 0 1 1.4-.8Z"/>
    <circle cx="12" cy="12" r="2.6"/>
  <% when :signout %>
    <path d="M16 12H4m12 0-4 4m4-4-4-4m3-4h2a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-2"/>
  <% when :menu %>
    <path stroke-width="2" d="M5 7h14M5 12h14M5 17h10"/>
  <% when :close %>
    <path stroke-width="2" d="M6 6l12 12M18 6L6 18"/>
  <% when :collapse %>
    <path stroke-width="2" d="M15 6l-6 6 6 6"/>
  <% end %>
</svg>
