<%# app/views/events/organiser.html.erb %>
<% content_for :title, "Your events" %>

<%= render "shared/sidebar" %>
<div class="app-main bg-mist">
  <section class="app-inner">

  <%# ── Header ─────────────────────────────────────────────── %>
  <header class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-[JetBrains_Mono] text-xs uppercase tracking-[0.22em] text-[#7620B1]">
        Organiser
      </p>
      <h1 class="mt-2 font-[Outfit] text-3xl font-semibold tracking-tight text-[#150D3A] sm:text-4xl">
        Your events
      </h1>
      <p class="mt-2 text-sm text-[#150D3A]/60">
        <% events = @events || Event.none %>

        <%= pluralize(events.size, "event") %> ·
        <%= pluralize(events.size, "event") %> ·
        <%= events.count(&:active?) || 0 %> on sale
      </p>
    </div>

    <%= link_to new_event_path,
          class: "inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#7620B1] to-[#FC8027] px-5 py-3 text-sm font-semibold text-[#7620B1] shadow-[0_10px_30px_-12px_rgba(118,32,177,0.8)] transition hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1] focus-visible:ring-offset-2" do %>
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 1 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1Z"/>
      </svg>
      Create an event
    <% end %>
  </header>
  <% if can?(:read, @events) %>
    <%# ── Grid ─────────────────────────────────────────────── %>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @events.each do |event| %>
        <% prices = event.ticket_types.select(&:active?).map(&:price).compact %>

        <article class="group relative isolate flex flex-col rounded-2xl bg-white ring-1 ring-[#150D3A]/10 transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_45px_-28px_rgba(21,13,58,0.7)] motion-reduce:transform-none motion-reduce:transition-none">

          <%# Poster %>
          <div class="relative aspect-[16/10] overflow-hidden rounded-t-2xl bg-[#150D3A]">
            <% if event.poster.attached? %>
              <%= image_tag event.poster,
                    alt: "",
                    loading: "lazy",
                    class: "h-full w-full object-cover transition duration-500 group-hover:scale-[1.04] motion-reduce:transform-none" %>
            <% else %>
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-[#7620B1] via-[#9B3AA8] to-[#FC8027]">
                <span class="font-[Outfit] text-6xl font-bold text-white/85">
                  <%= event.name.to_s.first&.upcase %>
                </span>
              </div>
            <% end %>

            <%# Status %>
            <span class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-2.5 py-1 font-[JetBrains_Mono] text-[10px] font-medium uppercase tracking-[0.14em] text-[#150D3A] backdrop-blur">
              <span class="h-1.5 w-1.5 rounded-full <%= event.active? ? 'bg-emerald-500' : 'bg-[#FC8027]' %>"></span>
              <%= event.active? ? "On sale" : "Draft" %>
            </span>
          </div>

          <%# Perforated tear — the ticket stub line %>
          <div class="relative">
            <span class="absolute -left-2 top-1/2 h-4 w-4 -translate-y-1/2 rounded-full bg-[#F7F4FB]" aria-hidden="true"></span>
            <span class="absolute -right-2 top-1/2 h-4 w-4 -translate-y-1/2 rounded-full bg-[#F7F4FB]" aria-hidden="true"></span>
            <div class="border-t border-dashed border-[#150D3A]/15"></div>
          </div>

          <%# Stub %>
          <div class="flex flex-1 flex-col gap-3 p-5">
            <p class="font-[JetBrains_Mono] text-[11px] uppercase tracking-[0.16em] text-[#7620B1]">
              <%= event.start_at ? event.start_at.strftime("%a %-d %b %Y · %H:%M") : "Date not set" %>
            </p>

            <h2 class="font-[Outfit] text-lg font-semibold leading-snug text-[#150D3A]">
              <%= link_to event.name, organiser_show_event_path(event),
                    class: "after:absolute after:inset-0 after:rounded-2xl focus:outline-none focus-visible:after:ring-2 focus-visible:after:ring-[#7620B1] focus-visible:after:ring-offset-2" %>
            </h2>

            <% if event.venue.present? %>
              <p class="flex items-start gap-1.5 text-sm text-[#150D3A]/60">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-[#150D3A]/35" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 2a5.5 5.5 0 0 0-5.5 5.5c0 4 5.5 10.5 5.5 10.5s5.5-6.5 5.5-10.5A5.5 5.5 0 0 0 10 2Zm0 7.5a2 2 0 1 1 0-4 2 2 0 0 1 0 4Z" clip-rule="evenodd"/>
                </svg>
                <span class="line-clamp-1"><%= event.venue %></span>
              </p>
            <% end %>

            <div class="mt-auto flex items-center justify-between border-t border-[#150D3A]/8 pt-4">
              <p class="font-[JetBrains_Mono] text-xs text-[#150D3A]/55">
                <% if prices.any? %>
                  From <span class="font-medium text-[#150D3A]"><%= number_to_currency(prices.min, unit: "KES ", precision: 0) %></span>
                <% else %>
                  No tickets yet
                <% end %>
              </p>

              <%= link_to "Edit", edit_event_path(event),
                    class: "relative z-10 rounded-full px-3 py-1.5 text-sm font-medium text-[#7620B1] transition hover:bg-[#7620B1]/8 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1]" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>

  <% else %>

    <%# ── Empty state ──────────────────────────────────────── %>
    <div class="rounded-2xl border border-dashed border-[#150D3A]/20 bg-white/60 px-6 py-16 text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-[#7620B1] to-[#FC8027]">
        <svg class="h-7 w-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2 2 2 0 0 0 0 4 2 2 0 0 1-2 2H6a2 2 0 0 1-2-2 2 2 0 0 0 0-4Z"/>
          <path stroke-linecap="round" stroke-dasharray="2 3" d="M12 6v10"/>
        </svg>
      </div>
      <h2 class="mt-5 font-[Outfit] text-xl font-semibold text-[#150D3A]">
        Nothing on sale yet
      </h2>
      <p class="mx-auto mt-2 max-w-sm text-sm text-[#150D3A]/60">
        Create an event, add your ticket types, and Salato handles checkout and the PDF tickets.
      </p>
      <%= link_to "Create an event", new_event_path,
            class: "mt-6 inline-flex rounded-full bg-gradient-to-r from-[#7620B1] to-[#FC8027] px-5 py-3 text-sm font-semibold text-white transition hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1] focus-visible:ring-offset-2" %>
    </div>

  <% end %>
</section>
</div>
