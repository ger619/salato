
<% available = ticket_type.available_quantity.to_i %>
<% sold_out  = available.zero? %>

<article class="stub rounded-[20px] p-6 transition
                <%= sold_out ? "bg-mist/60 ring-1 ring-ink/8" : "bg-white ring-1 ring-ink/12 hover:ring-ink/25" %>"
         style="--ty: calc(100% - 96px)">

  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <h3 class="text-[19px] font-semibold <%= "text-ink-soft/60" if sold_out %>">
        <%= ticket_type.name %>
      </h3>
      <% if ticket_type.description.present? %>
        <p class="mt-2 text-[14px] leading-relaxed <%= sold_out ? "text-ink-soft/50" : "text-ink-soft" %>">
          <%= ticket_type.description %>
        </p>
      <% end %>
    </div>

    <% if sold_out %>
      <span class="shrink-0 font-mono text-[10px] tracking-[.16em] px-2.5 py-1.5 rounded-lg bg-ink/8 text-ink-soft/70">
        SOLD OUT
      </span>
    <% elsif (note = ticket_scarcity(available)) %>
      <span class="shrink-0 font-mono text-[10px] tracking-[.16em] px-2.5 py-1.5 rounded-lg bg-flare/10 text-flare">
        <%= note %>
      </span>
    <% end %>
  </div>

  <div class="my-5 relative"><div class="tear <%= "tear-mist" if sold_out %>"></div></div>

  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="eyebrow text-ink-soft/55">Price</p>
      <p class="mt-1.5 font-display text-[26px] font-semibold leading-none <%= sold_out ? "text-ink-soft/50" : "grad-text" %>">
        KES <%= number_with_delimiter(ticket_type.price.to_i) %>
      </p>
    </div>

    <% if sold_out %>
      <span class="shrink-0 px-5 py-3 rounded-xl text-[15px] font-medium bg-ink/8 text-ink-soft/60 cursor-not-allowed"
            aria-disabled="true">
        Unavailable
      </span>
    <% else %>
      <%= link_to new_event_order_path(event.slug, ticket_type_id: ticket_type.id),
            class: "shrink-0 inline-flex items-center gap-2 px-5 py-3 rounded-xl text-[15px] font-medium text-white grad-bg hover:brightness-110 transition shadow-[0_8px_24px_-10px_rgba(225,55,101,.9)]" do %>
        Buy
        <span class="sr-only"><%= ticket_type.name %></span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
      <% end %>
    <% end %>
  </div>
</article>
