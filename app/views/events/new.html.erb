<% content_for :title, "New event · Salato" %>

<%= render "shared/sidebar" %>

<div class="min-h-screen bg-[#F7F4FB] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-5xl">

    <header class="mb-9">
      <%= link_to events_path, class: "inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.16em] text-[#150D3A]/45 transition hover:text-[#7620B1]" do %>
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        All events
      <% end %>

      <h1 class="mt-4 font-[Outfit] text-[32px] font-semibold leading-tight tracking-tight text-[#150D3A] sm:text-[40px]">
        Set up a new event
      </h1>
      <p class="mt-2 max-w-xl text-[15px] leading-6 text-[#150D3A]/55">
        Name it, pick the dates and venue, and Salato handles the ticket link, checkout and PDF tickets.
      </p>
    </header>

    <%= render "form", event: @event %>
  </div>
</div>
