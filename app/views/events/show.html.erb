<% content_for :main_class, "block" %>
<% content_for :title, "#{@event.name} — Salato" %>
<% content_for :description, truncate(strip_tags(@event.description.to_s), length: 155, separator: " ") %>

<%= render 'shared/header' %>


<%# ══════════════ HEADER ══════════════ %>
<% poster = @event.poster_variant(resize_to_limit: [1600, 900]) %>

<header class="relative overflow-hidden bg-ink text-white pt-28 lg:pt-32 pb-14 lg:pb-20">
  <% if poster %>
    <%# The poster's own colours, blurred, standing in for the gradient blobs. %>
    <%= image_tag poster,
                  alt: "", aria: { hidden: true },
                  class: "pointer-events-none absolute inset-0 w-full h-full object-cover scale-110 blur-2xl opacity-30" %>
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-b from-ink/75 via-ink/85 to-ink"></div>
  <% else %>
    <div aria-hidden="true" class="pointer-events-none absolute -top-32 -right-24 w-[560px] h-[560px] rounded-full blur-3xl opacity-40 grad-bg"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-40 -left-32 w-[420px] h-[420px] rounded-full blur-3xl opacity-25 grad-bg"></div>
  <% end %>

  <div class="max-w-shell mx-auto px-5 lg:px-8 relative">
    <%= link_to events_path, class: "inline-flex items-center gap-2 text-[14px] text-white/70 hover:text-white transition" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H6M11 18l-6-6 6-6"/></svg>
      All events
    <% end %>

    <%# The poster leads the page — everything else reads under it. %>
    <% if poster %>
      <figure class="mt-6 overflow-hidden rounded-3xl ring-1 ring-white/15 shadow-[0_40px_70px_-40px_rgba(0,0,0,.9)]">
        <%= image_tag poster,
                      alt: "Poster for #{@event.name}",
                      style: "max-width:100%;height:40vh;object-fit:cover;",
                      class: "block w-full" %>
      </figure>
    <% end %>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <span class="font-mono text-[10px] tracking-[.18em] px-3 py-1.5 rounded-lg grad-bg text-white">
        <%= event_countdown(@event) %>
      </span>
      <% if @ticket_types.any? && @ticket_types.all? { |t| t.available_quantity.to_i.zero? } %>
        <span class="font-mono text-[10px] tracking-[.18em] px-3 py-1.5 rounded-lg bg-white/15 text-white/85">
          SOLD OUT
        </span>
      <% end %>
    </div>

    <h1 class="mt-5 text-[38px] sm:text-[48px] lg:text-[60px] leading-[1.03] font-semibold max-w-4xl">
      <%= @event.name %>
    </h1>

    <div class="mt-7 flex flex-wrap gap-x-8 gap-y-4 text-[15px]">
      <div class="flex items-start gap-2.5">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-ember" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>
        </svg>
        <div>
          <p class="eyebrow text-white/45">Date</p>
          <p class="mt-1 text-white/90"><%= @event.start_at.strftime("%A %-d %B %Y") %></p>
          <p class="font-mono text-[13px] text-white/60">Doors <%= @event.start_at.strftime("%-l:%M %p") %></p>
        </div>
      </div>

      <div class="flex items-start gap-2.5">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-ember" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1116 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        <div>
          <p class="eyebrow text-white/45">Venue</p>
          <p class="mt-1 text-white/90"><%= @event.venue %></p>
        </div>
      </div>
    </div>
  </div>
</header>

<%# ══════════════ BODY ══════════════ %>
<div class="max-w-shell mx-auto px-5 lg:px-8 py-14 lg:py-20">
  <div class="grid lg:grid-cols-[1.1fr_.9fr] gap-12 lg:gap-16 items-start">

    <%# ── Left: what this event is ── %>
    <div>
      <% if @event.description.present? %>
        <h2 class="text-[26px] font-semibold">About this event</h2>
        <div class="mt-5 space-y-4 text-[17px] leading-[1.75] text-ink-soft">
          <%= simple_format @event.description %>
        </div>
      <% end %>

      <%# How the ticket works — answers the question every first-time buyer asks %>
      <div class="mt-12 rounded-[20px] bg-mist ring-1 ring-ink/8 p-7">
        <p class="eyebrow text-magenta">After you pay</p>
        <h3 class="mt-3 text-[20px] font-semibold">Your ticket arrives by email</h3>
        <ul class="mt-5 space-y-4 text-[15px] text-ink-soft">
          <% [["No account needed", "Enter your name, email and phone number. That's the whole checkout."],
              ["A PDF with a QR code", "It carries your name and a ticket number unique to you."],
              ["One scan at the gate", "The code works once. A forwarded screenshot won't get anyone else in."]].each do |title, body| %>
            <li class="flex gap-3">
              <span class="shrink-0 mt-0.5 w-6 h-6 rounded-full grad-bg grid place-items-center">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <span><span class="font-medium text-ink"><%= title %>.</span> <%= body %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <%# Share — the link is how this event actually spreads %>
      <div class="mt-8 flex flex-wrap items-center gap-3"
           data-controller="clipboard"
           data-clipboard-url-value="<%= event_url(@event.slug) %>">
        <span class="text-[14px] text-ink-soft">Share this event</span>
        <button type="button"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-[14px] font-medium ring-1 ring-ink/15 hover:bg-mist transition"
                data-action="clipboard#copy" data-clipboard-target="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/>
          </svg>
          <span data-clipboard-target="label">Copy link</span>
        </button>
        <%= link_to "WhatsApp",
                    "https://wa.me/?text=#{CGI.escape("#{@event.name} — #{event_url(@event.slug)}")}",
                    target: "_blank", rel: "noopener",
                    class: "inline-flex items-center px-4 py-2.5 rounded-xl text-[14px] font-medium ring-1 ring-ink/15 hover:bg-mist transition" %>
      </div>
    </div>

    <%# ── Right: the tickets ── %>
    <div id="tickets" class="lg:sticky lg:top-28 scroll-mt-28">
      <div class="flex items-baseline justify-between">
        <h2 class="text-[26px] font-semibold">Tickets</h2>
        <% if @ticket_types.any? %>
          <p class="font-mono text-[12px] text-ink-soft/70"><%= pluralize(@ticket_types.size, "type") %></p>
        <% end %>
      </div>

      <% if @ticket_types.empty? %>
        <div class="mt-5 rounded-[20px] border-2 border-dashed border-ink/15 bg-mist p-8 text-center">
          <p class="text-[16px] font-medium">Tickets aren't on sale yet</p>
          <p class="mt-2 text-[15px] text-ink-soft">Check back — the organiser hasn't opened sales for this one.</p>
        </div>
      <% else %>
        <div class="mt-5 space-y-4">
          <%= render partial: "events/ticket_type", collection: @ticket_types, as: :ticket_type, locals: { event: @event } %>
        </div>

        <p class="mt-5 text-[13px] leading-relaxed text-ink-soft/80">
          Prices include all fees. You'll pay with M-Pesa or card on the next screen.
        </p>
      <% end %>
    </div>

  </div>
</div>

<%# ══════════════ MOBILE STICKY BAR ══════════════ %>
<% cheapest = @ticket_types.select { |t| t.available_quantity.to_i.positive? }.min_by { |t| t.price.to_i } %>
<% if cheapest %>
  <div class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur border-t border-ink/10 px-5 py-3 flex items-center justify-between gap-4">
    <div class="min-w-0">
      <p class="eyebrow text-ink-soft/55">From</p>
      <p class="font-display text-[20px] font-semibold leading-none mt-1">
        KES <%= number_with_delimiter(cheapest.price.to_i) %>
      </p>
    </div>
    <a href="#tickets" class="shrink-0 px-6 py-3 rounded-xl font-medium text-white grad-bg hover:brightness-110 transition">
      Get tickets
    </a>
  </div>
  <div class="lg:hidden h-20" aria-hidden="true"></div>
<% end %>
