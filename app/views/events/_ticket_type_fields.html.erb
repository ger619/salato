<%#
  Salato — events/_ticket_type_fields
  One ticket tier row inside the event form.
  Rendered by fields_for, and cloned from a <template> for new rows.
%>

<% field_base = "w-full rounded-xl border border-[#150D3A]/10 bg-white px-4 py-2.5 text-[15px] leading-6 text-[#150D3A] placeholder-[#150D3A]/35 transition duration-150 focus:border-[#7620B1] focus:outline-none focus:ring-4 focus:ring-[#7620B1]/15" %>
<% label_base = "mb-1.5 block font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-[#150D3A]/45" %>

<div class="group relative rounded-2xl border border-[#150D3A]/10 bg-[#F7F4FB]/50 p-4 transition hover:border-[#7620B1]/25 sm:p-5"
     data-tier
     data-ticket-tiers-target="row">

  <%= f.hidden_field :_destroy, value: "0", data: { tier_destroy: true } %>

  <div class="mb-4 flex items-center justify-between gap-3">
    <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[#7620B1]"
          data-ticket-tiers-target="rowLabel">Tier</span>

    <button type="button"
            data-action="ticket-tiers#remove"
            data-ticket-tiers-target="removeButton"
            class="rounded-full p-1.5 text-[#150D3A]/30 transition hover:bg-white hover:text-[#C2410C] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#FC8027]/25 disabled:pointer-events-none disabled:opacity-25"
            aria-label="Remove this tier">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-12">
    <div class="sm:col-span-6">
      <%= f.label :name, "Tier name", class: label_base %>
      <%= f.text_field :name,
            placeholder: "Early Bird",
            class: "#{field_base} font-[Outfit] font-medium" %>
    </div>

    <div class="sm:col-span-3">
      <%= f.label :price, "Price", class: label_base %>
      <div class="relative">
        <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 font-mono text-[12px] text-[#150D3A]/40">KES</span>
        <%= f.number_field :price,
                           min: 1,
                           step: 1,
              placeholder: "1000",
              class: "#{field_base} pl-[52px] font-mono",
              data: { tier_price: true, action: "input->event-form#tiersChanged" } %>
      </div>
    </div>

    <div class="sm:col-span-3">
      <%= f.label :quantity, "Available", class: label_base %>
      <%= f.number_field :quantity,
            min: 1,
            step: 1,
            placeholder: "100",
            class: "#{field_base} font-mono",
            data: { tier_quantity: true, action: "input->event-form#tiersChanged" } %>
    </div>

    <div class="sm:col-span-12">
      <%= f.label :description, "What's included", class: label_base %>
      <%= f.text_field :description,
            maxlength: 120,
            placeholder: "Entry before 8pm, one welcome drink.",
            class: field_base %>
    </div>
  </div>

  <label class="mt-4 flex cursor-pointer items-center gap-3">
    <span class="relative inline-flex shrink-0">
      <%= f.check_box :active, class: "peer sr-only" %>
      <span class="h-5 w-9 rounded-full bg-[#150D3A]/15 transition-colors duration-200 peer-checked:bg-[#7620B1] peer-focus-visible:ring-4 peer-focus-visible:ring-[#7620B1]/25"></span>
      <span class="pointer-events-none absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white shadow-sm transition-transform duration-200 peer-checked:translate-x-4"></span>
    </span>
    <span class="text-[13px] text-[#150D3A]/60">On sale</span>
  </label>
</div>
