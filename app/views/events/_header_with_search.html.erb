<div class="flex flex-wrap items-end justify-between gap-6">
  <div class="max-w-2xl">
    <h1 class="font-display text-[36px] lg:text-[52px] leading-[1.06] font-semibold">
      Upcoming <span class="grad-text">events</span>
    </h1>
    <p class="mt-4 text-[17px] leading-relaxed text-ink-soft">
      Pick an event, pay with M-Pesa or card, and your ticket lands in your inbox straight away.
    </p>
  </div>

  <% if @total_count.positive? %>
    <p class="font-mono text-[13px] text-ink-soft/70 pb-2">
      <%= pluralize(@total_count, "event") %> on sale
    </p>
  <% end %>
</div>

<%= form_with url: events_path, method: :get, class: "mt-10" do |f| %>
  <div class="flex flex-col sm:flex-row gap-3">
    <div class="relative flex-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
           class="absolute left-4 top-1/2 -translate-y-1/2 text-ink/35">
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
      </svg>
      <%= f.label :q, "Search events", class: "sr-only" %>
      <%= f.search_field :q, value: @query,
                         placeholder: "Search by name, venue or artist",
                         class: "w-full rounded-xl border border-ink/10 bg-white pl-11 pr-4 py-3 text-[15px] text-ink placeholder-ink/35 focus:border-[#7620B1] focus:outline-none focus:ring-4 focus:ring-[#7620B1]/15 transition" %>
    </div>

    <%= f.label :event_type, "Event type", class: "sr-only" %>
    <%= f.select :event_type,
                 Event::EVENT_TYPES,
                 { include_blank: "All types", selected: @event_type },
                 { class: "sm:w-56 rounded-xl border border-ink/10 bg-white px-4 py-3 text-[15px] text-ink focus:border-[#7620B1] focus:outline-none focus:ring-4 focus:ring-[#7620B1]/15 transition",
                   onchange: "this.form.requestSubmit()" } %>

    <button type="submit"
            class="px-6 py-3 rounded-xl font-medium text-white grad-bg hover:brightness-110 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#7620B1]/25 transition">
      Search
    </button>
  </div>

  <% if @filtered %>
    <p class="mt-3 font-mono text-[13px] text-ink-soft/70">
      <%= pluralize(@total_count, "match") %><%= " for “#{@query}”" if @query.present? %><%= " in #{@event_type}" if @event_type.present? %>.
      <%= link_to "Clear", events_path, class: "underline underline-offset-4 hover:text-ink transition" %>
    </p>
  <% end %>
<% end %>

<% if @events.empty? && @filtered %>
  <div class="mt-8 rounded-[20px] bg-mist ring-1 ring-ink/8 p-10 text-center">
    <p class="text-[16px] font-medium">Nothing matched that</p>
    <p class="mt-2 text-[15px] text-ink-soft">Try a shorter search, or clear the type filter to see everything on sale.</p>
  </div>
<% end %>