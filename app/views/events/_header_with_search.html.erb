<%= form_with url: events_path, method: :get, class: "mt-10" do |f| %>
  <%= f.hidden_field :event_type, value: @event_type %>

  <div class="flex items-center gap-2 rounded-2xl border border-ink/10 bg-white p-2 shadow-[0_1px_2px_rgba(21,13,58,.04)] focus-within:border-[#7620B1] focus-within:ring-4 focus-within:ring-[#7620B1]/15 transition">
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
         class="ml-3 shrink-0 text-ink/35">
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    </svg>

    <%= f.label :q, "Search events", class: "sr-only" %>
    <%= f.search_field :q, value: @query,
                       placeholder: "Search by name, venue or artist",
                       class: "flex-1 min-w-0 bg-transparent border-0 px-2 py-2.5 text-[15px] text-ink placeholder-ink/35 focus:outline-none focus:ring-0" %>

    <button type="submit"
            class="shrink-0 px-5 sm:px-7 py-3 rounded-xl font-medium text-white grad-bg hover:brightness-110 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#7620B1]/25 transition">
      Search
    </button>
  </div>
<% end %>

<%# Type filters — links, so each carries the current search with it. %>
<%# Type filters — one row, links so each carries the current search. %>
<div class="mt-4 -mx-5 px-5 lg:mx-0 lg:px-0 overflow-x-auto lg:overflow-visible [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
  <div class="flex flex-nowrap items-center gap-2 w-max lg:w-full pb-1">
    <% types = [["All types", "", @all_count]] +
               Event::EVENT_TYPES.map { |t| [t, t, @type_counts[t].to_i] } %>

    <% types.each do |label, value, count| %>
      <% active = (@event_type == value) %>
      <%= link_to events_path(q: @query.presence, event_type: value.presence),
                  title: label,
                  aria: { current: (active ? "true" : nil) },
                  class: "group inline-flex items-center justify-center gap-1.5 shrink-0 lg:shrink lg:min-w-0 rounded-full px-4 lg:px-3 py-2 text-[14px] lg:text-[13px] font-medium transition focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#7620B1]/25 #{active ? 'grad-bg text-white' : 'bg-white ring-1 ring-ink/10 text-ink-soft hover:ring-ink/25 hover:text-ink'}" do %>
        <span class="truncate"><%= label %></span>
        <span class="font-mono text-[11px] tabular-nums shrink-0 rounded-full px-1.5 py-0.5 <%= active ? 'bg-white/20 text-white' : 'bg-ink/5 text-ink-soft/75' %>">
          <%= count %>
        </span>
      <% end %>
    <% end %>
  </div>
</div>
<% if @filtered %>
  <p class="mt-4 font-mono text-[13px] text-ink-soft/70">
    <%= pluralize(@total_count, "match") %><%= " for “#{@query}”" if @query.present? %>.
    <%= link_to "Clear", events_path, class: "underline underline-offset-4 hover:text-ink transition" %>
  </p>
<% end %>

<% if @events.empty? && @filtered %>
  <div class="mt-8 rounded-[20px] bg-mist ring-1 ring-ink/8 p-10 text-center">
    <p class="text-[16px] font-medium">Nothing matched that</p>
    <p class="mt-2 text-[15px] text-ink-soft">Try a shorter search, or pick a type with events in it.</p>
  </div>
<% end %>