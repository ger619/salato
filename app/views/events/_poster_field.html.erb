<%#
  Salato — events/_poster_field

  The poster band that sits at the top of the event form, above everything else.
  Render with:  <%= render "poster_field", f: f, event: event %>

Empty state and filled state are the same height, so nothing on the page
shifts when an image lands. Height is 40vh — a percentage height only
resolves against a parent that has a height of its own, and the page doesn't,
so 40% of the viewport is the version that actually renders.
%>

<% eyebrow      = "font-mono text-[11px] font-semibold uppercase tracking-[0.18em] text-[#7620B1]" %>
<% poster_style = "max-width:100%;height:40vh;object-fit:cover;" %>
<% attached     = event.poster_previewable? %>

<section data-controller="poster-upload"
         data-poster-upload-max-size-value="5242880"
         data-poster-upload-accept-value="image/png,image/jpeg,image/webp">

  <div class="mb-4 flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
    <div>
      <%= f.label :poster, "Poster", class: eyebrow %>
      <p class="mt-1.5 text-[14px] leading-5 text-[#150D3A]/55">
        The first thing a buyer sees — it sits at the top of the event page and on the share card.
      </p>
    </div>
    <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-[#150D3A]/40">
      JPG · PNG · WebP — up to 5 MB
    </p>
  </div>

  <%# The real input never shows; the band below drives it. %>
  <%= f.file_field :poster,
                   accept: "image/png,image/jpeg,image/webp",
                   class: "sr-only",
                   data: {
                     poster_upload_target: "input",
                     action: "change->poster-upload#fileChosen"
                   } %>

  <%= f.hidden_field :remove_poster,
                     value: "0",
                     data: { poster_upload_target: "removeFlag" } %>

  <%# ─────────────────── Empty state ─────────────────── %>
  <div data-poster-upload-target="zone"
       data-action="click->poster-upload#browse
                    dragenter->poster-upload#dragEnter
                    dragover->poster-upload#dragEnter
                    dragleave->poster-upload#dragLeave
                    drop->poster-upload#drop
                    keydown.enter->poster-upload#browse
                    keydown.space->poster-upload#browse"
       role="button"
       tabindex="0"
       aria-label="Add a poster image"
       style="height:40vh"
       class="<%= "hidden" if attached %> group relative flex w-full cursor-pointer flex-col items-center justify-center overflow-hidden rounded-[28px] border-2 border-dashed border-[#150D3A]/15 bg-[#F7F4FB] px-6 text-center transition duration-200 hover:border-[#7620B1]/45 hover:bg-[#7620B1]/[0.04] focus:outline-none focus-visible:border-[#7620B1] focus-visible:ring-4 focus-visible:ring-[#7620B1]/25 data-[dragging]:border-[#7620B1] data-[dragging]:bg-[#7620B1]/[0.07]">

    <%# Perforation, borrowed from the ticket stub — the poster is part of the ticket. %>
    <span aria-hidden="true" class="pointer-events-none absolute inset-x-10 top-1/2 hidden -translate-y-1/2 border-t border-dashed border-[#150D3A]/8 sm:block"></span>

    <span class="relative grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-[#7620B1] to-[#FC8027] text-white shadow-[0_12px_28px_-12px_rgba(118,32,177,0.95)] transition duration-200 group-hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 16V4M7 9l5-5 5 5" />
        <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
      </svg>
    </span>

    <p class="relative mt-5 font-[Outfit] text-[18px] font-medium text-[#150D3A]">
      Drop the poster here, or
      <span class="text-[#7620B1] underline decoration-[#7620B1]/30 underline-offset-4">browse</span>
    </p>
    <p class="relative mt-2 max-w-sm text-[14px] leading-5 text-[#150D3A]/45">
      Landscape crops best. A portrait poster keeps its middle and loses the top and bottom edges.
    </p>
  </div>

  <%# ─────────────────── Filled state ─────────────────── %>
  <figure data-poster-upload-target="preview"
          class="<%= "hidden" unless attached %> group relative overflow-hidden rounded-[28px] bg-[#150D3A] ring-1 ring-[#150D3A]/10">

    <%= tag.img(src: (url_for(event.poster) if attached),
                alt: "Poster for this event",
                style: poster_style,
                class: "block w-full",
                data: {
                  poster_upload_target: "image",
                  action: "load->poster-upload#imageLoaded"
                }) %>

    <%# Scrim, so the caption stays readable over a bright poster. %>
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-[#150D3A]/85 via-[#150D3A]/40 to-transparent"></div>

    <div class="absolute right-4 top-4 flex gap-2">
      <button type="button"
              data-action="poster-upload#browse"
              class="rounded-full bg-white/92 px-4 py-2 text-[13px] font-medium text-[#150D3A] shadow-sm backdrop-blur transition hover:bg-white focus:outline-none focus-visible:ring-4 focus-visible:ring-white/50">
        Replace
      </button>
      <button type="button"
              data-action="poster-upload#remove"
              class="rounded-full bg-white/92 px-4 py-2 text-[13px] font-medium text-[#C2410C] shadow-sm backdrop-blur transition hover:bg-white focus:outline-none focus-visible:ring-4 focus-visible:ring-white/50">
        Remove
      </button>
    </div>

    <figcaption class="absolute inset-x-0 bottom-0 flex flex-wrap items-baseline gap-x-3 gap-y-1 px-5 pb-4 sm:px-6 sm:pb-5">
      <span class="max-w-full truncate font-[Outfit] text-[15px] font-medium text-white"
            data-poster-upload-target="filename">
        <%= event.poster.filename.to_s if attached %>
      </span>
      <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-white/60">
        <span data-poster-upload-target="filesize"><%= number_to_human_size(event.poster.byte_size) if attached %></span><span data-poster-upload-target="dimensions"></span>
      </span>
    </figcaption>
  </figure>

  <p class="mt-2.5 hidden text-[13px] leading-5 text-[#C2410C]"
     data-poster-upload-target="error"
     role="alert"></p>
</section>
