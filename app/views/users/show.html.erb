<%# app/views/users/show.html.erb %>
<%
  name         = @user.full_name.presence
  initials     = [@user.first_name, @user.last_name].compact_blank.map { |n| n[0] }.join.upcase
  grad         = "bg-[linear-gradient(105deg,#7620B1_0%,#AB2692_34%,#E13765_62%,#FC8027_100%)]"
  panel        = "rounded-2xl bg-white p-6 ring-1 ring-ink/10"
  h2_c         = "font-[Outfit] text-base font-semibold text-ink"
  dt_c         = "eyebrow text-ink2/60"
  dd_c         = "mt-1 text-[15px] text-ink"
  muted        = "mt-1 text-[15px] text-ink2/40"
  date         = ->(t) { t&.strftime("%d %b %Y") }
  datetime     = ->(t) { t&.strftime("%d %b %Y, %H:%M") }

  can_edit       = current_user.has_role?(:admin) || current_user.has_role?(:organiser)
  can_toggle     = current_user.admin? && @user != current_user
  invite_pending = @user.invitation_created_at.present? && @user.invitation_accepted_at.nil?
%>

<% content_for :title, "#{name || @user.email} — Salato" %>
<%= render 'shared/sidebar' %>

<div class="app-main min-h-dvh bg-mist">
  <section class="app-inner">

    <%= link_to users_path,
                class: "inline-flex items-center gap-1.5 text-[13px] font-medium text-ink2/60 transition hover:text-violet" do %>
      <span aria-hidden="true">&larr;</span> All people
    <% end %>

    <%# ══════════ PASS: who this person is, at a glance ══════════ %>
    <article class="relative mt-4 flex flex-col overflow-hidden rounded-3xl bg-white ring-1 ring-ink/10
                    shadow-[0_24px_48px_-24px_rgba(21,13,58,.35)] sm:flex-row">
      <div class="absolute inset-x-0 top-0 h-1.5 <%= grad %>" aria-hidden="true"></div>

      <%# Main part %>
      <div class="min-w-0 flex-1 p-6 pt-8 sm:p-8">
        <div class="flex items-start gap-4 sm:gap-5">
          <div class="flex size-16 shrink-0 items-center justify-center rounded-2xl <%= grad %>
                      font-[Outfit] text-xl font-bold text-white shadow-[0_10px_24px_-10px_rgba(118,32,177,.7)]">
            <%= initials.presence || "?" %>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h1 class="truncate font-[Outfit] text-[26px] font-semibold leading-tight text-ink">
                  <%= name || "Unnamed" %>
                </h1>
                <p class="mt-0.5 truncate text-[14px] text-ink2">
                  <%= @user.client&.name || tag.span("No organisation", class: "text-ink2/40") %>
                </p>
              </div>

              <% if can_edit %>
                <%= link_to edit_user_path(@user),
                            class: "inline-flex h-10 shrink-0 items-center gap-2 rounded-xl #{grad} px-4
                                    font-[Outfit] text-[14px] font-semibold text-white
                                    shadow-[0_8px_20px_-8px_rgba(118,32,177,.6)] transition
                                    hover:brightness-105 active:scale-[0.98]
                                    focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-violet/25" do %>
                  <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="size-4" aria-hidden="true">
                    <path d="M13.6 3.6a2 2 0 0 1 2.8 2.8L7 15.8l-3.5.7.7-3.5 9.4-9.4Z" stroke-linejoin="round"/>
                  </svg>
                  <span>Edit details</span>
                <% end %>
              <% end %>
            </div>

            <div class="mt-3 flex flex-wrap gap-1.5">
              <% if @user.roles.any? %>
                <% @user.roles.each do |role| %>
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium <%= role_pill_classes(role) %>">
                    <%= role_label(role) %>
                  </span>
                <% end %>
              <% else %>
                <span class="text-[13px] text-ink2/40">No role</span>
              <% end %>
            </div>
          </div>
        </div>

        <dl class="mt-6 grid gap-4 border-t border-ink/5 pt-5 sm:grid-cols-2">
          <div class="min-w-0">
            <dt class="<%= dt_c %>">Email</dt>
            <dd class="<%= dd_c %> truncate"><%= mail_to @user.email, @user.email, class: "transition hover:text-violet" %></dd>
          </div>
          <div>
            <dt class="<%= dt_c %>">Mobile</dt>
            <% if @user.phone_number.present? %>
              <dd class="<%= dd_c %> mono">
                <%= link_to @user.phone_number, "tel:#{@user.phone_number.gsub(/\s+/, '')}", class: "transition hover:text-violet" %>
              </dd>
            <% else %>
              <dd class="<%= muted %>">Not provided</dd>
            <% end %>
          </div>
        </dl>
      </div>

      <%# Perforation: horizontal on mobile, vertical from sm up. Notches match the page background. %>
      <div class="relative h-0 sm:h-auto sm:w-0" aria-hidden="true">
        <div class="absolute inset-x-6 top-0 border-t-2 border-dashed border-ink/10 sm:hidden"></div>
        <div class="absolute inset-y-8 left-0 hidden -translate-x-1/2 border-l-2 border-dashed border-ink/10 sm:block"></div>
        <span class="absolute -left-3 -top-3 size-6 rounded-full bg-mist"></span>
        <span class="absolute -right-3 -top-3 size-6 rounded-full bg-mist
                     sm:right-auto sm:top-auto sm:-bottom-3 sm:-left-3"></span>
      </div>

      <%# Stub %>
      <aside class="flex shrink-0 flex-row items-center justify-between gap-6 bg-mist/40 p-6
                    sm:w-56 sm:flex-col sm:items-start sm:justify-center sm:p-8">
        <div>
          <p class="<%= dt_c %>">Status</p>
          <div class="mt-2 flex items-center gap-3">
            <% if can_toggle %>
              <%= form_with url: status_user_path(@user), method: :patch,
                            data: { turbo_confirm: "Change #{name || 'this user'}'s status?" } do |form| %>
                <label class="relative inline-block h-7 w-12 shrink-0 cursor-pointer rounded-full">
                  <span class="sr-only">Active</span>
                  <%= form.check_box :active, checked: @user.status, class: "peer sr-only",
                                     onchange: "this.form.requestSubmit()" %>
                  <span class="absolute inset-0 rounded-full bg-slate-300 transition-colors duration-300
                               peer-checked:bg-[#0D9C66]
                               peer-focus-visible:ring-2 peer-focus-visible:ring-violet peer-focus-visible:ring-offset-2"></span>
                  <span class="absolute left-1 top-1 h-5 w-5 rounded-full bg-white shadow
                               transition-transform duration-300 peer-checked:translate-x-full"></span>
                </label>
              <% end %>
            <% else %>
              <span class="size-2.5 rounded-full <%= @user.status ? "bg-[#0D9C66]" : "bg-slate-300" %>" aria-hidden="true"></span>
            <% end %>
            <span class="text-[14px] font-semibold <%= @user.status ? "text-[#0D9C66]" : "text-ink2/50" %>">
              <%= @user.status ? "Active" : "Inactive" %>
            </span>
          </div>
        </div>

        <div class="text-right sm:text-left">
          <p class="<%= dt_c %>">Member since</p>
          <p class="mt-1 font-[Outfit] text-[15px] font-semibold text-ink"><%= date.(@user.created_at) %></p>
        </div>
      </aside>
    </article>

    <%# ══════════ NEEDS ATTENTION ══════════ %>
    <% if @user.locked_at || @user.confirmed_at.nil? || invite_pending %>
      <ul class="mt-4 space-y-2" aria-label="Needs attention">
        <% if @user.locked_at %>
          <li class="flex items-center gap-3 rounded-xl bg-pink/10 px-4 py-3 text-[14px] ring-1 ring-pink/25">
            <span class="size-2 shrink-0 rounded-full bg-pink" aria-hidden="true"></span>
            <span><span class="font-semibold text-pink">Account locked</span>
              <span class="text-ink2">since <%= datetime.(@user.locked_at) %> after <%= pluralize(@user.failed_attempts.to_i, "failed sign-in") %>.</span></span>
          </li>
        <% end %>
        <% if invite_pending %>
          <li class="flex items-center gap-3 rounded-xl bg-coral/10 px-4 py-3 text-[14px] ring-1 ring-coral/25">
            <span class="size-2 shrink-0 rounded-full bg-coral" aria-hidden="true"></span>
            <span><span class="font-semibold text-coral">Invitation not accepted</span>
              <span class="text-ink2"><%= "Sent #{date.(@user.invitation_sent_at)}." if @user.invitation_sent_at %></span></span>
          </li>
        <% elsif @user.confirmed_at.nil? %>
          <li class="flex items-center gap-3 rounded-xl bg-coral/10 px-4 py-3 text-[14px] ring-1 ring-coral/25">
            <span class="size-2 shrink-0 rounded-full bg-coral" aria-hidden="true"></span>
            <span><span class="font-semibold text-coral">Email not confirmed</span>
              <span class="text-ink2">They can't sign in until they confirm.</span></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div class="mt-6 grid gap-6 lg:grid-cols-3">

      <%# ══════════ MAIN COLUMN ══════════ %>
      <div class="space-y-6 lg:col-span-2">

        <section class="<%= panel %>" aria-labelledby="identity-heading">
          <h2 id="identity-heading" class="<%= h2_c %>">Identity</h2>
          <dl class="mt-5 grid gap-5 sm:grid-cols-2">
            <div>
              <dt class="<%= dt_c %>">ID number / passport</dt>
              <% if @user.id_number.present? %>
                <dd class="<%= dd_c %> mono"><%= @user.id_number %></dd>
              <% else %>
                <dd class="<%= muted %>">Not provided</dd>
              <% end %>
            </div>

            <div>
              <dt class="<%= dt_c %>">ID document</dt>
              <% if @user.respond_to?(:id_photo) && @user.id_photo.attached? %>
                <dd class="mt-2">
                  <% if @user.id_photo.image? %>
                    <%= link_to rails_blob_path(@user.id_photo, disposition: "inline"), target: "_blank", rel: "noopener",
                                class: "group relative block w-fit overflow-hidden rounded-xl ring-1 ring-ink/10 transition hover:ring-violet/40" do %>
                      <%= image_tag @user.id_photo, class: "h-36 w-auto object-cover", alt: "ID document for #{name || @user.email}" %>
                      <span class="absolute inset-x-0 bottom-0 bg-ink/70 px-3 py-1.5 text-[12px] font-medium text-white opacity-0 transition group-hover:opacity-100">
                        Open full size
                      </span>
                    <% end %>
                  <% else %>
                    <%= link_to "View document", rails_blob_path(@user.id_photo, disposition: "inline"), target: "_blank", rel: "noopener",
                                class: "inline-flex items-center gap-2 rounded-xl bg-violet/10 px-3.5 py-2 font-[Outfit] text-[13px] font-bold text-violet transition hover:bg-violet/20" %>
                  <% end %>
                </dd>
              <% else %>
                <dd class="<%= muted %>">Not uploaded</dd>
              <% end %>
            </div>
          </dl>
        </section>

        <section class="<%= panel %>" aria-labelledby="activity-heading">
          <h2 id="activity-heading" class="<%= h2_c %>">Account activity</h2>
          <dl class="mt-5 grid gap-5 sm:grid-cols-3">
            <div>
              <dt class="<%= dt_c %>">Sign-ins</dt>
              <dd class="mt-1 font-[Outfit] text-[22px] font-semibold text-ink mono"><%= @user.sign_in_count %></dd>
            </div>
            <div>
              <dt class="<%= dt_c %>">Last sign-in</dt>
              <% if @user.last_sign_in_at %>
                <dd class="<%= dd_c %>"><%= datetime.(@user.last_sign_in_at) %></dd>
              <% else %>
                <dd class="<%= muted %>">Never</dd>
              <% end %>
            </div>
            <div class="min-w-0">
              <dt class="<%= dt_c %>">Last IP</dt>
              <% if @user.last_sign_in_ip.present? %>
                <dd class="<%= dd_c %> mono truncate"><%= @user.last_sign_in_ip %></dd>
              <% else %>
                <dd class="<%= muted %>">—</dd>
              <% end %>
            </div>
          </dl>
          <p class="mt-5 border-t border-ink/5 pt-4 text-[13px] text-ink2/60">
            Profile last updated <%= datetime.(@user.updated_at) %>
          </p>
        </section>
      </div>

      <%# ══════════ SIDE COLUMN ══════════ %>
      <div class="space-y-6">

        <section class="<%= panel %>" aria-labelledby="email-heading">
          <h2 id="email-heading" class="<%= h2_c %>">Email</h2>
          <dl class="mt-5 space-y-5">
            <div>
              <dt class="<%= dt_c %>">Confirmed</dt>
              <% if @user.confirmed_at %>
                <dd class="<%= dd_c %>"><%= date.(@user.confirmed_at) %></dd>
              <% else %>
                <dd class="mt-1 text-[15px] font-medium text-coral">Pending</dd>
              <% end %>
            </div>
            <% if @user.unconfirmed_email.present? %>
              <div class="min-w-0">
                <dt class="<%= dt_c %>">Changing to</dt>
                <dd class="<%= dd_c %> truncate"><%= @user.unconfirmed_email %></dd>
              </div>
            <% end %>
          </dl>
        </section>

        <section class="<%= panel %>" aria-labelledby="security-heading">
          <h2 id="security-heading" class="<%= h2_c %>">Security</h2>
          <dl class="mt-5 space-y-5">
            <div>
              <dt class="<%= dt_c %>">Failed attempts</dt>
              <dd class="mt-1 text-[15px] mono <%= @user.failed_attempts.to_i.positive? ? "text-coral" : "text-ink" %>">
                <%= @user.failed_attempts.to_i %>
              </dd>
            </div>
            <div>
              <dt class="<%= dt_c %>">Password reset sent</dt>
              <% if @user.reset_password_sent_at %>
                <dd class="<%= dd_c %>"><%= date.(@user.reset_password_sent_at) %></dd>
              <% else %>
                <dd class="<%= muted %>">Never</dd>
              <% end %>
            </div>
          </dl>
        </section>

        <% if @user.invitation_created_at.present? %>
          <section class="<%= panel %>" aria-labelledby="invitation-heading">
            <h2 id="invitation-heading" class="<%= h2_c %>">Invitation</h2>
            <dl class="mt-5 space-y-5">
              <div>
                <dt class="<%= dt_c %>">Sent</dt>
                <dd class="<%= @user.invitation_sent_at ? dd_c : muted %>"><%= date.(@user.invitation_sent_at) || "—" %></dd>
              </div>
              <div>
                <dt class="<%= dt_c %>">Accepted</dt>
                <% if @user.invitation_accepted_at %>
                  <dd class="<%= dd_c %>"><%= date.(@user.invitation_accepted_at) %></dd>
                <% else %>
                  <dd class="mt-1 text-[15px] font-medium text-coral">Not yet</dd>
                <% end %>
              </div>
              <div class="min-w-0">
                <dt class="<%= dt_c %>">Invited by</dt>
                <% inviter = @user.invited_by %>
                <dd class="<%= inviter ? dd_c : muted %> truncate">
                  <%= inviter ? (inviter.try(:full_name).presence || inviter.try(:name).presence || inviter.try(:email) || "—") : "—" %>
                </dd>
              </div>
            </dl>
          </section>
        <% end %>
      </div>
    </div>
  </section>
</div>