<% provide(:title, "Edit details for: #{@user.full_name.presence || @user.email}") %>
<% admin = current_user.has_role?(:admin) %>
<% can_edit = admin || current_user.has_role?(:organiser) %>
<% display_name = @user.full_name.presence || @user.email %>
<% initials = display_name.to_s.split(/[\s@.]/).reject(&:blank?).first(2).map(&:first).join.upcase %>
<% field = "block h-11 w-full rounded-xl border border-[#E4DDF0] bg-white px-3.5 text-sm text-[#150D3A] placeholder:text-[#150D3A]/35 transition focus:border-[#7620B1] focus:outline-none focus:ring-4 focus:ring-[#7620B1]/15" %>
<% locked = "cursor-not-allowed bg-mist text-[#150D3A]/60 focus:ring-0 focus:border-[#E4DDF0]" %>
<% roles = assignable_roles %>
<% role_descriptions = {
  "admin" => "Full access to every client, event and setting.",
  "organiser" => "Creates events, sells tickets and manages their team.",
  "scanner" => "Checks tickets in at the door."
} %>
<% role_id_strings = roles.map { |role| role.id.to_s } %>
<% current_role_id = @user.role_ids.map(&:to_s).find { |id| role_id_strings.include?(id) } %>


<%= render 'shared/sidebar' %>

<div class="app-main min-h-dvh bg-mist">
  <section class="app-inner text-[#150D3A]">
    <div class="mx-auto max-w-3xl py-6 sm:py-10">

      <% if can_edit %>
        <%= form_with model: @user, url: user_path(@user), method: :patch,
                      class: "overflow-hidden rounded-3xl bg-white shadow-[0_1px_0_#E4DDF0,0_24px_48px_-24px_rgba(21,13,58,0.35)]" do |f| %>

          <%# Ticket header %>
          <div class="relative bg-gradient-to-br from-[#7620B1] via-[#A0339A] to-[#FC8027] px-6 pb-8 pt-7 text-white sm:px-8">
            <p class="text-sm font-medium text-white/80">Edit roles</p>
            <div class="mt-3 flex items-center gap-4">
              <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-white/15 font-['Outfit',sans-serif] text-xl font-semibold ring-1 ring-white/40 backdrop-blur-sm">
                <%= initials %>
              </span>
              <div class="min-w-0">
                <h1 class="truncate font-['Outfit',sans-serif] text-2xl font-semibold leading-tight sm:text-3xl"><%= display_name %></h1>
                <% if @user.full_name.present? %>
                  <p class="truncate text-sm text-white/80"><%= @user.email %></p>
                <% end %>
              </div>
            </div>
            <% if @user.roles.any? %>
              <p class="mt-4 flex flex-wrap gap-1.5">
                <% @user.roles.map(&:name).uniq.each do |name| %>
                  <span class="rounded-full bg-white/15 px-2.5 py-0.5 text-xs font-medium capitalize ring-1 ring-white/30"><%= name %></span>
                <% end %>
              </p>
            <% end %>
          </div>

          <%# Ticket tear %>
          <div class="relative h-0" aria-hidden="true">
            <span class="absolute -left-4 -top-4 size-8 rounded-full bg-mist"></span>
            <span class="absolute -right-4 -top-4 size-8 rounded-full bg-mist"></span>
            <div class="mx-8 border-t-2 border-dashed border-[#E4DDF0]"></div>
          </div>

          <div class="space-y-8 px-6 pb-8 pt-8 sm:px-8">
            <%# Every error, not just roles, so a failed save always says why. %>
            <% if @user.errors.any? %>
              <div role="alert" class="rounded-xl border border-[#FC8027]/40 bg-[#FC8027]/10 px-4 py-3 text-sm text-[#9A3D06]">
                <p class="font-semibold">These changes weren't saved:</p>
                <ul class="mt-1 list-disc pl-5">
                  <% @user.errors.full_messages.uniq.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div>
              <h2 class="font-['Outfit',sans-serif] text-base font-semibold">Name</h2>
              <div class="mt-3 grid gap-4 sm:grid-cols-2">
                <div>
                  <%= f.label :first_name, "First name", class: "mb-1.5 block text-sm font-medium text-[#150D3A]/80" %>
                  <%= f.text_field :first_name, autofocus: admin, autocomplete: "given-name", placeholder: "Jay",
                                   required: admin, readonly: !admin, class: class_names(field, locked => !admin) %>
                </div>
                <div>
                  <%= f.label :last_name, "Last name", class: "mb-1.5 block text-sm font-medium text-[#150D3A]/80" %>
                  <%= f.text_field :last_name, autocomplete: "family-name", placeholder: "Strong",
                                   required: admin, readonly: !admin, class: class_names(field, locked => !admin) %>
                </div>
              </div>
              <% unless admin %>
                <p class="mt-2 text-xs text-[#150D3A]/55">Only admins can change names.</p>
              <% end %>
            </div>

            <fieldset>
              <legend class="font-['Outfit',sans-serif] text-base font-semibold">Role</legend>
              <p class="mt-0.5 text-sm text-[#150D3A]/60">
                <%= admin ? "Pick what this person can do in Salato." : "You can make this person an organiser or a scanner." %>
              </p>
              <div class="mt-3 grid gap-2 sm:grid-cols-3">
                <%= f.collection_radio_buttons :role_id, roles, :id, :name, { checked: current_role_id } do |b| %>
                  <%= b.label class: "group flex cursor-pointer select-none items-start gap-3 rounded-2xl border border-[#E4DDF0] bg-white p-4 transition
                          hover:border-[#7620B1]/50
                          has-[:checked]:border-[#7620B1] has-[:checked]:bg-[#7620B1]/[0.05] has-[:checked]:ring-1 has-[:checked]:ring-[#7620B1]
                          has-[:focus-visible]:ring-4 has-[:focus-visible]:ring-[#7620B1]/25" do %>
                    <%= b.radio_button class: "sr-only" %>
                    <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border-2 border-[#CFC6DE] bg-white transition
                     group-has-[:checked]:border-[#7620B1]" aria-hidden="true">
          <span class="size-2.5 scale-0 rounded-full bg-[#7620B1] transition group-has-[:checked]:scale-100"></span>
        </span>
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold capitalize text-[#150D3A]"><%= b.text %></span>
                      <% if (description = role_descriptions[b.object.name]) %>
                        <span class="mt-0.5 block text-xs leading-relaxed text-[#150D3A]/60"><%= description %></span>
                      <% end %>
                    </span>
                  <% end %>
                <% end %>
              </div>
            </fieldset>
            <div>
              <%= f.label :client_id, "Client", class: "font-['Outfit',sans-serif] text-base font-semibold" %>
              <p class="mt-0.5 text-sm text-[#150D3A]/60">The organisation this person works for.</p>
              <div class="mt-3 sm:max-w-sm">
                <% if admin %>
                  <%= f.collection_select :client_id, Client.order(:name), :id, :name,
                                          { include_blank: "Select client" }, class: field %>
                <% else %>
                  <p class="<%= field %> <%= locked %> flex items-center"><%= @user.client&.name || "No client" %></p>
                  <p class="mt-2 text-xs text-[#150D3A]/55">Only admins can move people between clients.</p>
                <% end %>
              </div>
            </div>
          </div>

          <div class="flex flex-col-reverse gap-3 border-t border-[#E4DDF0] bg-mist/60 px-6 py-4 sm:flex-row sm:items-center sm:justify-end sm:px-8">
            <%= link_to "Cancel", user_path(@user), class: "inline-flex h-11 items-center justify-center rounded-xl px-5 text-sm font-semibold text-[#150D3A]/70 transition hover:bg-white hover:text-[#150D3A]" %>
            <%= f.submit "Save", id: "button",
                         class: "h-11 cursor-pointer rounded-xl bg-gradient-to-r from-[#7620B1] to-[#FC8027] px-7 font-['Outfit',sans-serif] text-sm font-semibold text-white shadow-[0_8px_20px_-8px_rgba(118,32,177,0.6)] transition hover:brightness-105 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#7620B1]/25" %>
          </div>
        <% end %>

      <% else %>
        <div class="rounded-3xl bg-white p-8 text-center shadow-[0_1px_0_#E4DDF0]">
          <h1 class="font-['Outfit',sans-serif] text-xl font-semibold">You can't edit roles</h1>
          <p class="mt-1 text-sm text-[#150D3A]/60">Ask an admin to change roles or client access for <%= display_name %>.</p>
          <%= link_to "Go back", user_path(@user), class: "mt-5 inline-flex h-11 items-center rounded-xl border border-[#E4DDF0] px-5 text-sm font-semibold hover:bg-mist" %>
        </div>
      <% end %>

    </div>
  </section>
</div>