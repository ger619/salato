<%# app/views/salato_mailer/ticket_confirmation.html.erb

  A port of tickets/_ticket.html.erb (FULL variant) into email HTML: same
  band, event block, tear and stub, rebuilt with tables and inline styles
  because Gmail and Outlook strip Tailwind and most of a <style> block.

  Self-contained on purpose — layouts/mailer.html.erb is still the Rails
  default, so nothing here depends on classes living in the layout.

  Needs from SalatoMailer: @order, @event, @tickets, @download_url.
  The QR lives in the attached PDF, not here: ticket_qr_svg returns an SVG
  and every major client strips SVG out of the body.
%>
<% font     = "'Inter Tight', 'Helvetica Neue', Helvetica, Arial, sans-serif" %>
<% mono     = "'JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, monospace" %>
<% ink      = '#150D3A' %>
<% ink2     = '#3A3260' %>
<% muted    = '#6F6890' %>
<% faint    = '#8B84A6' %>
<% hairline = '#E6E1EF' %>
<% perf     = '#C9C2DA' %>
<% mist     = '#F7F4FB' %>
<% violet   = '#7620B1' %>
<% magenta  = '#AB2692' %>
<% gradient = 'linear-gradient(105deg, #7620B1 0%, #AB2692 34%, #E13765 62%, #FC8027 100%)' %>
<% total    = @tickets.size %>
<% pdf_name = "#{@order.reference}-tickets.pdf" %>

<%# inbox preview line %>
<div style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:<%= mist %>; opacity:0;">
  <%= total == 1 ? 'Your ticket is' : "All #{total} tickets are" %> attached as a PDF. Show the QR code at the gate.
  <%= raw('&#8199;&#65279;&#847; ' * 40) %>
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
       style="border-collapse:collapse; background-color:<%= mist %>;">
  <tr>
    <td align="center" style="padding:26px 12px 44px;">

      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"
             style="width:100%; max-width:600px; border-collapse:collapse;">

        <%# ── wordmark ──────────────────────────────────────────────────── %>
        <tr>
          <td style="padding:0 6px 16px; font-family:<%= mono %>; font-size:11px; letter-spacing:.22em; color:<%= faint %>; text-transform:uppercase;">
            Salato
          </td>
        </tr>

        <%# ── greeting + actions ────────────────────────────────────────── %>
        <tr>
          <td style="padding:0 6px 22px; font-family:<%= font %>;">
            <h1 style="margin:0; font-size:26px; line-height:33px; font-weight:600; color:<%= ink %>;">
              <%= total == 1 ? 'Your ticket is confirmed' : "Your #{total} tickets are confirmed" %>
            </h1>

            <p style="margin:10px 0 0; font-size:15px; line-height:23px; color:<%= ink2 %>;">
              <%= @order.customer_name.to_s.split.first.presence || 'Hello' %>, your payment came through.
              <%= total == 1 ? 'Your ticket is' : 'All of them are' %> attached as
              <span style="font-family:<%= mono %>; font-size:13px; color:<%= ink %>; word-break:break-all;"><%= pdf_name %></span><%= ' — one page per ticket' if total > 1 %>.
              We scan the QR code inside at the gate.
            </p>

            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px; border-collapse:collapse;">
              <tr>
                <td bgcolor="<%= violet %>" style="border-radius:10px; background-color:<%= violet %>; background-image:<%= gradient %>;">
                  <a href="<%= @download_url %>"
                     style="display:inline-block; padding:13px 26px; font-family:<%= font %>; font-size:14px; font-weight:600; line-height:18px; color:#FFFFFF; text-decoration:none; border-radius:10px;">
                    Download <%= total == 1 ? 'ticket' : 'tickets' %> (PDF)
                  </a>
                </td>

                <td width="10" style="width:10px; font-size:0; line-height:0;">&nbsp;</td>

                <td style="border:1px solid <%= hairline %>; border-radius:10px; background-color:#FFFFFF;">
                  <a href="<%= event_order_url(@event, @order) %>"
                     style="display:inline-block; padding:12px 22px; font-family:<%= font %>; font-size:14px; font-weight:600; line-height:18px; color:<%= ink %>; text-decoration:none; border-radius:10px;">
                    View online
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <%# ══════════════ ticket cards ══════════════ %>
        <% @tickets.each_with_index do |ticket, index| %>
          <% pill = ticket_status_pill(ticket) %>
          <% style = case ticket.status
                     when 'valid'      then { bg: '#FFFFFF', border: violet, fg: violet }
                     when 'checked_in' then { bg: ink, border: ink, fg: '#FFFFFF' }
                     else                   { bg: '#EDE9F3', border: '#EDE9F3', fg: ink2 }
                     end %>

          <tr>
            <td style="padding:0 0 16px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                     style="border-collapse:collapse; background-color:#FFFFFF; border:1px solid <%= hairline %>; border-radius:22px; overflow:hidden;">

                <%# ── band ──────────────────────────────────────────────── %>
                <tr>
                  <td bgcolor="<%= violet %>" style="background-color:<%= violet %>; background-image:<%= gradient %>; padding:15px 24px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                      <tr>
                        <td style="font-family:<%= mono %>; font-size:10px; letter-spacing:.2em; color:#FFFFFF; text-transform:uppercase; white-space:nowrap;">
                          Admit one<% if total > 1 %> &middot; <%= index + 1 %> of <%= total %><% end %>
                        </td>
                        <td align="right" style="font-family:<%= mono %>; font-size:10px; letter-spacing:.2em; color:#FFFFFF; text-transform:uppercase;">
                          <%= ticket.ticket_type.name %>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <%# ── event ─────────────────────────────────────────────── %>
                <tr>
                  <td style="padding:24px 24px 20px; font-family:<%= font %>;">
                    <p style="margin:0; font-family:<%= mono %>; font-size:11px; letter-spacing:.14em; color:<%= magenta %>; text-transform:uppercase;">
                      <%= ticket.event.start_at.strftime('%A %-d %B') %>
                    </p>

                    <p style="margin:9px 0 0; font-size:27px; line-height:33px; font-weight:600; color:<%= ink %>;">
                      <%= ticket.event.name %>
                    </p>

                    <p style="margin:7px 0 0; font-size:15px; line-height:22px; color:<%= ink2 %>;">
                      <%= ticket.event.venue.presence || 'Venue to be announced' %>
                      &middot;
                      <%= ticket.event.start_at.strftime('%-l:%M %p').downcase %>
                    </p>

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:22px; border-collapse:collapse;">
                      <tr>
                        <td width="50%" valign="top" style="width:50%; padding-right:8px;">
                          <p style="margin:0; font-family:<%= mono %>; font-size:9px; letter-spacing:.14em; color:<%= muted %>; text-transform:uppercase;">Holder</p>
                          <p style="margin:5px 0 0; font-size:14px; line-height:19px; font-weight:600; color:<%= ink %>;"><%= ticket.attendee_name %></p>
                        </td>
                        <td width="50%" valign="top" style="width:50%;">
                          <p style="margin:0; font-family:<%= mono %>; font-size:9px; letter-spacing:.14em; color:<%= muted %>; text-transform:uppercase;">Paid</p>
                          <p style="margin:5px 0 0; font-size:14px; line-height:19px; font-weight:600; color:<%= ink %>;">
                            <%= ticket.order.currency %> <%= number_with_delimiter(ticket.order.unit_price.to_i) %>
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <%# ── tear ──────────────────────────────────────────────── %>
                <tr>
                  <td style="padding:0; font-size:0; line-height:0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                      <tr>
                        <td width="16" style="width:16px; font-size:0; line-height:0;">
                          <div style="width:16px; height:16px; background-color:<%= mist %>; border-radius:50%; font-size:0; line-height:0;">&nbsp;</div>
                        </td>
                        <td valign="middle" style="padding:0 8px; font-size:0; line-height:0;">
                          <div style="border-top:1px dashed <%= perf %>; font-size:0; line-height:0;">&nbsp;</div>
                        </td>
                        <td width="16" align="right" style="width:16px; font-size:0; line-height:0;">
                          <div style="width:16px; height:16px; background-color:<%= mist %>; border-radius:50%; font-size:0; line-height:0;">&nbsp;</div>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <%# ── stub ──────────────────────────────────────────────── %>
                <tr>
                  <td style="padding:24px 24px 6px; font-family:<%= font %>;">
                    <p style="margin:0; font-family:<%= mono %>; font-size:9px; letter-spacing:.14em; color:<%= muted %>; text-transform:uppercase;">
                      Ticket number
                    </p>
                    <p style="margin:6px 0 0; font-family:<%= mono %>; font-size:15px; line-height:20px; font-weight:500; color:<%= ink %>; word-break:break-all;">
                      <%= ticket.ticket_number %>
                    </p>

                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:14px; border-collapse:collapse;">
                      <tr>
                        <td bgcolor="<%= style[:bg] %>"
                            style="background-color:<%= style[:bg] %>; border:1px solid <%= style[:border] %>; border-radius:20px; padding:5px 13px; font-family:<%= font %>; font-size:12px; line-height:16px; font-weight:500; color:<%= style[:fg] %>;">
                          <%= pill[:label] %>
                        </td>
                      </tr>
                    </table>

                    <p style="margin:18px 0 0; font-size:12px; line-height:18px; color:<%= muted %>;">
                      The QR code for this ticket is on page <%= index + 1 %> of the attached PDF.
                      Scan at the gate. Valid for one entry.
                    </p>
                  </td>
                </tr>

                <%# ── card footer ───────────────────────────────────────── %>
                <tr>
                  <td style="padding:14px 24px 20px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; border-top:1px solid <%= hairline %>;">
                      <tr>
                        <td style="padding-top:15px; font-family:<%= mono %>; font-size:10px; letter-spacing:.14em; color:<%= faint %>; text-transform:uppercase; word-break:break-all;">
                          Salato &middot; Ref <%= ticket.order.reference %>
                        </td>
                        <td align="right" style="padding-top:15px; white-space:nowrap;">
                          <a href="<%= download_ticket_url(ticket) %>"
                             style="font-family:<%= mono %>; font-size:10px; letter-spacing:.14em; color:<%= violet %>; text-decoration:none; text-transform:uppercase;">
                            PDF
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        <% end %>

        <%# ══════════════ receipt ══════════════ %>
        <tr>
          <td style="padding:6px 0 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                   style="border-collapse:collapse; background-color:#FFFFFF; border:1px solid <%= hairline %>; border-radius:16px;">
              <tr>
                <td style="padding:20px 24px; font-family:<%= font %>;">
                  <p style="margin:0 0 12px; font-family:<%= mono %>; font-size:9px; letter-spacing:.16em; color:<%= muted %>; text-transform:uppercase;">
                    Order
                  </p>

                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; font-size:14px; line-height:20px;">
                    <tr>
                      <td style="padding:3px 0; color:<%= muted %>;">Reference</td>
                      <td align="right" style="padding:3px 0; font-family:<%= mono %>; font-size:12px; color:<%= ink %>; word-break:break-all;">
                        <%= @order.reference %>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding:3px 0; color:<%= muted %>;">
                        <%= @order.ticket_type.name %> &times; <%= @order.quantity %>
                      </td>
                      <td align="right" style="padding:3px 0; color:<%= ink2 %>;">
                        <%= @order.currency %> <%= number_with_delimiter(@order.unit_price.to_i) %>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding:10px 0 0; font-weight:600; color:<%= ink %>;">Paid</td>
                      <td align="right" style="padding:10px 0 0; font-weight:600; color:<%= ink %>;">
                        <%= @order.currency %> <%= number_with_delimiter(@order.total_price.to_i) %>
                      </td>
                    </tr>
                    <% if @order.paid_at %>
                      <tr>
                        <td colspan="2" style="padding:9px 0 0; font-size:12px; color:<%= faint %>;">
                          <%= @order.paid_at.strftime('%-d %b %Y at %-l:%M %p').downcase %>
                        </td>
                      </tr>
                    <% end %>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <%# ── sign-off ──────────────────────────────────────────────────── %>
        <tr>
          <td style="padding:20px 6px 0; font-family:<%= font %>; font-size:12px; line-height:19px; color:<%= faint %>;">
            Keep this email to yourself — anyone holding the code can use it.
            Questions about this order? Reply here or write to
            <a href="mailto:hello@salato.app" style="color:<%= violet %>; text-decoration:none;">hello@salato.app</a>.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
