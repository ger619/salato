<div class="rounded-2xl bg-white ring-1 ring-ink/10 p-5">
  <p class="eyebrow text-ink2/60">Enter the ticket number</p>

  <%= form_with url: verify_path, method: :get, class: "mt-3 flex gap-2" do |f| %>
    <%= f.text_field :token,
                     value: local_assigns[:query],
                     autofocus: true,
                     autocomplete: "off",
                     autocapitalize: "characters",
                     placeholder: "TXT-…",
                     class: "flex-1 min-w-0 rounded-xl px-4 py-3 text-[15px] mono
                             bg-mist ring-1 ring-ink/12 focus:outline-none
                             focus:ring-2 focus:ring-violet" %>

    <%= f.submit "Check",
                 class: "grad-bg text-white rounded-xl px-5 py-3 text-[15px]
                         font-medium cursor-pointer hover:opacity-90 transition" %>
  <% end %>
</div>