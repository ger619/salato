<%= form_with url: lookup_verification_path, method: :post,
              id: "ticket_lookup_form", class: "space-y-2" do |f| %>
  <%= f.label :token, "Or enter the ticket number",
              class: "block text-[13px] text-ink2" %>
  <%= f.text_field :token, id: "ticket_query",
                   value: local_assigns[:query],
                   autocomplete: "off", autocapitalize: "characters", spellcheck: false,
                   class: "mono w-full rounded-xl bg-white px-4 py-3 text-[15px]
                           ring-1 ring-ink/15 focus:ring-2 focus:ring-ink outline-none" %>
  <%= f.submit "Look up ticket",
               class: "w-full rounded-xl bg-white py-3 font-[Outfit] text-[15px]
                       font-bold text-ink ring-1 ring-ink/15 hover:bg-mist transition" %>
<% end %>