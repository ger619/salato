<% content_for :title, "Verify a ticket — Salato" %>
<%= render 'shared/sidebar' %>

<section class="bg-mist min-h-screen pt-28 lg:pt-32 pb-20">
  <div class="max-w-shell mx-auto px-5 lg:px-8">
    <div class="mx-auto max-w-[440px]"
         data-controller="qr-scanner"
         data-qr-scanner-input-value="#ticket_query"
         data-qr-scanner-form-value="#ticket_lookup_form">

      <h1 class="text-[26px] leading-tight font-semibold">Verify a ticket</h1>
      <p class="mt-2 text-[15px] text-ink2">
        Scan the QR code, or type the number printed on the ticket.
      </p>

      <%# ── scan button ── %>
      <button type="button"
              data-action="qr-scanner#start"
              data-qr-scanner-target="startButton"
              class="mt-6 flex w-full items-center justify-center gap-2.5 rounded-xl
                     bg-[linear-gradient(105deg,#7620B1_0%,#AB2692_34%,#E13765_62%,#FC8027_100%)]
                     py-3.5 font-[Outfit] text-[15px] font-bold text-white
                     shadow-lg shadow-[#E13765]/30 transition
                     hover:shadow-xl hover:shadow-[#E13765]/40 hover:brightness-105
                     active:scale-[0.99]">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
          <circle cx="12" cy="13" r="4"/>
        </svg>
        Scan with camera
      </button>

      <%# ── camera stage (hidden until the button is pressed) ── %>
      <div data-qr-scanner-target="stage" class="mt-6 hidden">
        <div class="relative overflow-hidden rounded-2xl bg-ink ring-1 ring-ink/10
                    shadow-[0_18px_40px_-20px_rgba(21,13,58,.35)]">
          <video data-qr-scanner-target="video"
                 class="block aspect-square w-full object-cover"
                 muted playsinline></video>

          <%# jsQR fallback draws frames here; never shown to the user %>
          <canvas data-qr-scanner-target="canvas" class="hidden"></canvas>

          <%# viewfinder %>
          <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
            <div class="h-3/5 w-3/5 rounded-2xl border-2 border-white/70
                        shadow-[0_0_0_9999px_rgba(21,13,58,.45)]"></div>
          </div>
        </div>

        <button type="button"
                data-action="qr-scanner#cancel"
                class="mt-3 w-full rounded-xl bg-white py-3 font-[Outfit] text-[15px]
                       font-bold text-ink ring-1 ring-ink/15 transition
                       hover:bg-mist active:scale-[0.99]">
          Cancel
        </button>
      </div>

      <p data-qr-scanner-target="status"
         role="status"
         class="mt-3 text-[13px] text-ink2 empty:hidden"></p>

      <%# ── manual entry ── %>
      <div class="mt-6">
        <%= render "manual_entry", query: @query %>
      </div>
    </div>
  </div>
</section>
