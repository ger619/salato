<% content_for :title, "Ticket not recognised — Salato" %>
<%= render 'shared/sidebar' %>


<section class="bg-mist min-h-screen pt-28 lg:pt-32 pb-20">
  <div class="max-w-shell mx-auto px-5 lg:px-8">
    <div class="mx-auto max-w-[440px]">

      <div class="rounded-[22px] bg-white overflow-hidden ring-1 ring-ink/10
                  shadow-[0_30px_70px_-25px_rgba(21,13,58,.38)]">

        <div class="bg-red-600 px-6 py-4">
          <span class="mono text-[11px] tracking-[.2em] text-white/95">
            DO NOT ADMIT
          </span>
        </div>

        <div class="px-6 pt-7 pb-8 text-center">
          <span class="mx-auto w-14 h-14 rounded-full bg-red-50 grid place-items-center">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#dc2626"
                 stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
          </span>

          <h1 class="mt-4 text-[24px] leading-tight font-semibold">
            Ticket not recognised
          </h1>

          <p class="mt-2 text-[15px] text-ink2 leading-snug">
            This code doesn't match any ticket. It may have been mistyped,
            damaged, or it isn't a Salato ticket.
          </p>
        </div>
      </div>

      <div class="mt-6 rounded-2xl bg-white ring-1 ring-ink/10 p-5">
        <p class="eyebrow text-ink2/60">Enter the code by hand</p>

        <%= form_with url: verify_path, method: :get, class: "mt-3 flex gap-2" do |f| %>
          <%= f.text_field :token,
                           autofocus: true,
                           autocomplete: "off",
                           placeholder: "Ticket code",
                           class: "flex-1 min-w-0 rounded-xl px-4 py-3 text-[15px] mono
                                   bg-mist ring-1 ring-ink/12 focus:outline-none
                                   focus:ring-2 focus:ring-violet" %>

          <%= f.submit "Check",
                       class: "grad-bg text-white rounded-xl px-5 py-3 text-[15px]
                               font-medium cursor-pointer hover:opacity-90 transition" %>
        <% end %>
      </div>

    </div>
  </div>
</section>