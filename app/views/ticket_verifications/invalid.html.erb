<% content_for :title, "Ticket not found — Salato" %>
<%= render 'shared/sidebar' %>

<section class="bg-mist min-h-screen pt-28 lg:pt-32 pb-20">
  <div class="max-w-shell mx-auto px-5 lg:px-8">
    <div class="mx-auto max-w-[440px]">

      <div class="text-center">
        <span class="mx-auto w-16 h-16 rounded-full bg-white grid place-items-center
                     ring-1 ring-ink/8">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#E13765"
               stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </span>

        <h1 class="mt-4 text-[26px] leading-tight font-semibold">No ticket found</h1>

        <p class="mt-2 text-[15px] text-ink2">
          <% if @query.present? %>
            Nothing matches <span class="mono break-all"><%= @query %></span>.
            Check the number printed on the ticket, or scan again.
          <% else %>
            Check the number printed on the ticket, or scan again.
          <% end %>
        </p>
      </div>

      <%= link_to "Scan again", verify_path,
                  class: "mt-6 block w-full rounded-xl
                          bg-[linear-gradient(105deg,#7620B1_0%,#AB2692_34%,#E13765_62%,#FC8027_100%)]
                          py-3.5 text-center font-[Outfit] text-[15px] font-bold text-white
                          shadow-lg shadow-[#E13765]/30 transition
                          hover:shadow-xl hover:shadow-[#E13765]/40 hover:brightness-105" %>

      <div class="mt-4">
        <%= render "manual_entry", query: @query %>
      </div>

    </div>
  </div>
</section>
