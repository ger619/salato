<%#
  locals: label, value, delta (Integer or nil), series (Array of numbers),
          caption (optional)
%>
<div class="rounded-[18px] bg-white ring-1 ring-ink/10 p-5 sm:p-6">
  <div class="flex items-start justify-between gap-3">
    <p class="eyebrow text-ink-soft/55"><%= label %></p>
    <span class="shrink-0 font-mono text-[10px] tracking-[.1em] px-2 py-1 rounded-lg <%= delta_classes(delta) %>">
      <%= delta_label(delta) %>
    </span>
  </div>

  <p class="mt-3 font-display text-[26px] sm:text-[30px] font-semibold leading-none"><%= value %></p>

  <% if local_assigns[:caption].present? %>
    <p class="mt-1.5 text-[13px] text-ink-soft/70"><%= caption %></p>
  <% end %>

  <% if Array(local_assigns[:series]).any? { |v| v.to_f.positive? } %>
    <svg viewBox="0 0 100 28" preserveAspectRatio="none" class="mt-4 w-full h-8 overflow-visible" aria-hidden="true">
      <path d="<%= sparkline_path(series) %>" fill="none"
            stroke="url(#sparkGrad)" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round"
            vector-effect="non-scaling-stroke"/>
    </svg>
  <% else %>
    <div class="mt-4 h-8" aria-hidden="true"></div>
  <% end %>
</div>
