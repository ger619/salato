<% content_for :title, "Tickets — Salato" %>
<%= render 'shared/sidebar' %>

<%= render "shared/sidebar" %>
<div class="app-main bg-mist">
  <section class="app-inner">

    <%# ── heading ── %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-[26px] leading-tight font-semibold">Tickets</h1>
        <p class="mt-1.5 text-[15px] text-ink2">
          <%= number_with_delimiter(@total) %>
          <%= "ticket".pluralize(@total) %>
          <%= "matching your search" if @query.present? %>
        </p>
      </div>

      <%= link_to "Verify a ticket", verify_path,
                  class: "rounded-xl grad-bg px-5 py-3 font-[Outfit] text-[15px]
                          font-bold text-white transition hover:opacity-90" %>
    </div>

    <%# ── search + filters ── %>
    <%= form_with url: tickets_path, method: :get, data: { turbo_frame: "_top" },
                  class: "mt-6 rounded-2xl bg-white p-4 ring-1 ring-ink/10
                          shadow-[0_18px_40px_-28px_rgba(21,13,58,.35)]" do |f| %>
      <div class="grid gap-3 md:grid-cols-[1fr_auto_auto_auto]">
        <div class="relative">
          <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-ink2/60"
               viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
               stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
          </svg>

          <%= f.search_field :q, value: @query,
                placeholder: "Name, email, ticket number, event…",
                autocomplete: "off",
                class: "w-full rounded-xl bg-mist py-3 pl-10 pr-4 text-[15px]
                        ring-1 ring-ink/10 outline-none transition
                        focus:bg-white focus:ring-2 focus:ring-ink" %>
        </div>

        <%= f.select :event_id,
              options_from_collection_for_select(@events, :id, :name, @event_id),
              { include_blank: "All events" },
              class: "rounded-xl bg-mist px-4 py-3 text-[15px] ring-1 ring-ink/10
                      outline-none focus:bg-white focus:ring-2 focus:ring-ink" %>

        <%= f.select :status,
                     options_for_select(@statuses.map { |s| [s.to_s.humanize, s] }, @status),              { include_blank: "Any status" },
              class: "rounded-xl bg-mist px-4 py-3 text-[15px] ring-1 ring-ink/10
                      outline-none focus:bg-white focus:ring-2 focus:ring-ink" %>

        <div class="flex gap-2">
          <%= f.submit "Search",
                class: "rounded-xl grad-bg px-5 py-3 font-[Outfit] text-[15px]
                        font-bold text-white transition hover:opacity-90" %>

          <% if @query.present? || @status.present? || @event_id.present? %>
            <%= link_to "Clear", tickets_path,
                  class: "rounded-xl bg-white px-4 py-3 font-[Outfit] text-[15px]
                          font-bold text-ink2 ring-1 ring-ink/15 transition hover:bg-mist" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @tickets.any? %>

      <%# ── mobile: stacked cards ── %>
      <div class="mt-6 space-y-3 lg:hidden">
        <% @tickets.each do |ticket| %>
          <%= link_to verify_ticket_path(ticket.qr_token),
                      class: "block rounded-2xl bg-white p-4 ring-1 ring-ink/10
                              shadow-[0_18px_40px_-28px_rgba(21,13,58,.35)]
                              transition active:scale-[0.995]" do %>
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-[16px] font-medium truncate"><%= ticket.attendee_name %></p>
                <% if ticket.respond_to?(:attendee_email) && ticket.attendee_email.present? %>
                  <p class="mt-0.5 text-[13px] text-ink2 truncate"><%= ticket.attendee_email %></p>
                <% end %>
              </div>

              <% status_ui = ticket_status_pill(ticket) %>
              <span class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-medium ring-1 <%= status_ui[:classes] %>">
                <%= status_ui[:label] %>
              </span>
            </div>

            <dl class="mt-3 grid grid-cols-2 gap-y-2 text-[13px]">
              <div class="min-w-0">
                <dt class="text-ink2/70">Event</dt>
                <dd class="truncate font-medium"><%= ticket.event&.name || "—" %></dd>
              </div>
              <div class="min-w-0">
                <dt class="text-ink2/70">Type</dt>
                <dd class="truncate font-medium"><%= ticket.ticket_type&.name || "—" %></dd>
              </div>
              <div class="col-span-2 min-w-0">
                <dt class="text-ink2/70">Ticket number</dt>
                <dd class="mono break-all font-medium"><%= ticket.ticket_number %></dd>
              </div>
            </dl>
          <% end %>
        <% end %>
      </div>

      <%# ── desktop: table ── %>
      <div class="mt-6 hidden overflow-hidden rounded-[22px] bg-white ring-1 ring-ink/10
                  shadow-[0_30px_70px_-30px_rgba(21,13,58,.32)] lg:block">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-[14px]">
            <thead>
              <tr class="border-b border-ink/8 text-[12px] text-ink2/70">
                <th class="px-5 py-3.5 font-medium">Attendee</th>
                <th class="px-5 py-3.5 font-medium">Event</th>
                <th class="px-5 py-3.5 font-medium">Ticket type</th>
                <th class="px-5 py-3.5 font-medium">Ticket number</th>
                <th class="px-5 py-3.5 font-medium">Status</th>
                <th class="px-5 py-3.5 font-medium">Checked in</th>
                <th class="px-5 py-3.5 font-medium">Purchased</th>
                <th class="px-5 py-3.5"><span class="sr-only">Open</span></th>
              </tr>
            </thead>

            <tbody>
              <% @tickets.each do |ticket| %>
                <tr class="border-b border-ink/6 transition last:border-0 hover:bg-mist/60">
                  <td class="px-5 py-4">
                    <p class="font-medium"><%= ticket.attendee_name %></p>
                    <% if ticket.respond_to?(:attendee_email) && ticket.attendee_email.present? %>
                      <p class="mt-0.5 text-[13px] text-ink2"><%= ticket.attendee_email %></p>
                    <% end %>
                    <% if ticket.respond_to?(:attendee_phone) && ticket.attendee_phone.present? %>
                      <p class="mono mt-0.5 text-[12px] text-ink2/80"><%= ticket.attendee_phone %></p>
                    <% end %>
                  </td>

                  <td class="px-5 py-4"><%= ticket.event&.name || "—" %></td>
                  <td class="px-5 py-4"><%= ticket.ticket_type&.name || "—" %></td>

                  <td class="px-5 py-4">
                    <span class="mono text-[13px]"><%= ticket.ticket_number %></span>
                  </td>

                  <td class="px-5 py-4">
                    <% status_ui = ticket_status_pill(ticket) %>
                    <span class="shrink-0 rounded-full px-2.5 py-1 text-[11px] font-medium ring-1 <%= status_ui[:classes] %>">
                      <%= status_ui[:label] %>
                    </span>
                  </td>

                  <td class="px-5 py-4 text-ink2">
                    <%= ticket.checked_in_at&.strftime("%-d %b, %-l:%M %p") || "—" %>
                  </td>

                  <td class="px-5 py-4 text-ink2">
                    <%= ticket.created_at.strftime("%-d %b %Y") %>
                  </td>

                  <td class="px-5 py-4 text-right">
                    <%= link_to "Open", verify_ticket_path(ticket.qr_token),
                          class: "font-medium text-[#7620B1] hover:underline" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <%= render "pagination" %>

    <% else %>

      <%# ── empty state ── %>
      <div class="mt-6 rounded-[22px] bg-white px-6 py-14 text-center ring-1 ring-ink/10">
        <h2 class="text-[19px] font-semibold">
          <%= @query.present? || @status.present? || @event_id.present? ? "No tickets match those filters" : "No tickets yet" %>
        </h2>
        <p class="mx-auto mt-2 max-w-[36ch] text-[15px] text-ink2">
          <% if @query.present? || @status.present? || @event_id.present? %>
            Try a shorter search term, or clear the filters to see everything.
          <% else %>
            Tickets appear here as soon as someone buys one.
          <% end %>
        </p>

        <% if @query.present? || @status.present? || @event_id.present? %>
          <%= link_to "Clear filters", tickets_path,
                class: "mt-5 inline-block rounded-xl bg-white px-5 py-3 font-[Outfit]
                        text-[15px] font-bold text-ink ring-1 ring-ink/15 hover:bg-mist" %>
        <% end %>
      </div>

    <% end %>
  </section>
</div>
