<%= form_with model: client,
              url: client.persisted? ? onboarding_client_path(client) : onboarding_clients_path,
              method: client.persisted? ? :patch : :post,
              class: "space-y-5" do |f| %>
  <% if client.errors.any? %>
    <div class="rounded-2xl bg-[#FC8027]/10 px-4 py-3 ring-1 ring-[#FC8027]/30">
      <p class="font-[Outfit] text-sm font-semibold text-[#150D3A]">
        <%= pluralize(client.errors.count, "field needs", plural: "fields need") %> fixing
      </p>
      <ul class="mt-1.5 list-disc space-y-0.5 pl-5 text-sm text-[#150D3A]/70">
        <% client.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% field_class = "w-full rounded-xl border-0 bg-white px-4 py-2.5 text-sm text-[#150D3A] ring-1 ring-[#150D3A]/10 placeholder:text-[#150D3A]/35 focus:outline-none focus:ring-2 focus:ring-[#7620B1]" %>
  <% label_class = "block font-[JetBrains_Mono] text-[11px] uppercase tracking-[0.14em] text-[#150D3A]/55" %>

  <div>
    <%= f.label :name, "Name", class: label_class %>
    <%= f.text_field :name, placeholder: "Nairobi Live Ltd", class: "mt-1.5 #{field_class}" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :email, "Email", class: label_class %>
      <%= f.email_field :email, placeholder: "bookings@example.co.ke", class: "mt-1.5 #{field_class}" %>
    </div>

    <div>
      <%= f.label :phone, "Phone", class: label_class %>
      <%= f.telephone_field :phone, placeholder: "+254 700 000 000", class: "mt-1.5 #{field_class}" %>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :city, "City", class: label_class %>
      <%= f.text_field :city, placeholder: "Nairobi", class: "mt-1.5 #{field_class}" %>
    </div>

    <div>
      <%= f.label :country, "Country", class: label_class %>
      <%= f.text_field :country, placeholder: "Kenya", class: "mt-1.5 #{field_class}" %>
    </div>
  </div>

  <div>
    <%= f.label :address, "Address", class: label_class %>
    <%= f.text_area :address, rows: 3, placeholder: "Street, building, city", class: "mt-1.5 #{field_class}" %>
  </div>

  <div class="rounded-2xl bg-[#7620B1]/5 p-5 ring-1 ring-[#7620B1]/15 space-y-4">
    <h3 class="font-[Outfit] text-sm font-semibold text-[#150D3A]">Paystack Subaccount & Settlement</h3>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= f.label :settlement_bank, "Settlement Bank (Bank Code)", class: label_class %>
        <%= f.text_field :settlement_bank, placeholder: "e.g. 044, kcb, etc.", class: "mt-1.5 #{field_class}" %>
      </div>

      <div>
        <%= f.label :account_number, "Account Number", class: label_class %>
        <%= f.text_field :account_number, placeholder: "0123456789", class: "mt-1.5 #{field_class}" %>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= f.label :percentage_charge, "Platform Percentage Charge (%)", class: label_class %>
        <%= f.number_field :percentage_charge, step: "0.01", min: "0", max: "100", placeholder: "5.0", class: "mt-1.5 #{field_class}" %>
        <span class="mt-1 block text-xs text-[#150D3A]/50">Percentage retained by the platform per transaction</span>
      </div>

      <div>
        <%= f.label :paystack_subaccount_code, "Paystack Subaccount Code", class: label_class %>
        <%= f.text_field :paystack_subaccount_code, placeholder: "ACCT_xxxxxxxx (auto-generated if empty)", class: "mt-1.5 #{field_class}", required: true %>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= f.label :registration_number, "Registration Number", class: label_class %>
        <%= f.text_field :registration_number, placeholder: "CPR/2026/...", class: "mt-1.5 #{field_class}" %>
      </div>

      <div>
        <%= f.label :tax_pin, "Tax PIN", class: label_class %>
        <%= f.text_field :tax_pin, placeholder: "P051234567Z", class: "mt-1.5 #{field_class}" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-1">
    <%= f.submit submit_label,
          class: "cursor-pointer rounded-full bg-gradient-to-r from-[#7620B1] to-[#FC8027] px-5 py-2.5 text-sm font-semibold text-[#7620B1] border border-[#7620B1] transition hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1] focus-visible:ring-offset-2" %>

    <%= link_to "Cancel", client.persisted? ? onboarding_clients_path(client) : onboarding_clients_path,
          class: "rounded-full px-4 py-2.5 text-sm font-medium text-[#150D3A]/60 transition hover:bg-[#150D3A]/5 border border-[#7620B1]/25"
    %>
  </div>
<% end %>
