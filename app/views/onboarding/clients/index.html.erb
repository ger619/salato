<%= render 'shared/sidebar' %>

<div class="app-main bg-mist">
  <section class="app-inner">

    <%# ── Header ───────────────────────────────────────────── %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-[JetBrains_Mono] text-[11px] uppercase tracking-[0.16em] text-[#7620B1]">
          Salato
        </p>
        <h1 class="mt-1 font-[Outfit] text-2xl font-semibold text-[#150D3A]">
          Clients
        </h1>
        <p class="mt-1 text-sm text-[#150D3A]/60">
          <%= pluralize(@clients.size, "client") %> on file
        </p>
      </div>

      <%= link_to "Add a client", new_onboarding_client_path,
            class: "inline-flex rounded-full bg-gradient-to-r from-[#7620B1] to-[#FC8027] px-5 py-2.5 text-sm font-semibold text-[#7620B1] border border-[#7620B1] transition hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1] focus-visible:ring-offset-2" %>
    </div>

    <%# ── Search ───────────────────────────────────────────── %>
    <%= form_with url: onboarding_clients_path, method: :get, class: "mt-6" do |f| %>
      <div class="flex flex-wrap items-center gap-2">
        <div class="relative max-w-sm flex-1">
          <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[#150D3A]/35"
               viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 3.4 9.84l3.13 3.13a.75.75 0 1 0 1.06-1.06l-3.13-3.13A5.5 5.5 0 0 0 9 3.5Zm-4 5.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z" clip-rule="evenodd"/>
          </svg>
          <%= f.search_field :q, value: params[:q], placeholder: "Search name, email or phone",
                class: "w-full rounded-full border-0 bg-white py-2.5 pl-10 pr-4 text-sm text-[#150D3A] ring-1 ring-[#150D3A]/10 placeholder:text-[#150D3A]/35 focus:outline-none focus:ring-2 focus:ring-[#7620B1]" %>
        </div>

        <% if params[:q].present? %>
          <%= link_to "Clear", onboarding_clients_path,
                class: "rounded-full px-4 py-2.5 text-sm font-medium text-[#150D3A]/60 ring-1 ring-[#150D3A]/12 transition hover:bg-white" %>
        <% end %>
      </div>
    <% end %>

    <% if @clients.present? %>

      <%# ── Mobile: cards ──────────────────────────────────── %>
      <div class="mt-6 space-y-3 lg:hidden">
        <% @clients.each do |client| %>
          <article class="group relative isolate flex items-center gap-4 rounded-2xl bg-white px-4 py-4 ring-1 ring-[#150D3A]/10 transition hover:bg-[#F7F4FB]/70">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[#7620B1] to-[#FC8027] font-[Outfit] text-sm font-bold text-white">
              <%= client.name.to_s.first&.upcase %>
            </span>

            <div class="min-w-0 flex-1">
              <h2 class="font-[Outfit] text-base font-semibold leading-snug text-[#150D3A]">
                <%= link_to client.name, onboarding_client_path(client),
                      class: "after:absolute after:inset-0 focus:outline-none focus-visible:after:ring-2 focus-visible:after:ring-[#7620B1]" %>
              </h2>
              <p class="mt-0.5 truncate font-[JetBrains_Mono] text-xs text-[#150D3A]/55">
                <%= [client.email, client.phone].compact_blank.join(" · ").presence || "No contact details yet" %>
              </p>
              <% location = [client.city, client.country].compact_blank.join(", ") %>
              <% if location.present? %>
                <p class="mt-0.5 truncate text-xs text-[#150D3A]/45"><%= location %></p>
              <% end %>
            </div>

            <%= link_to "Edit", edit_onboarding_client_path(client),
                  class: "relative z-10 shrink-0 rounded-full px-3 py-1.5 text-sm font-medium text-[#7620B1] transition hover:bg-[#7620B1]/8 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1]" %>
          </article>
        <% end %>
      </div>

      <%# ── Desktop: table ─────────────────────────────────── %>
      <div class="mt-6 hidden overflow-hidden rounded-2xl bg-white ring-1 ring-[#150D3A]/10 lg:block">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-[#150D3A]/8 bg-[#F7F4FB]/60">
                <th class="px-5 py-3 font-[JetBrains_Mono] text-[10px] font-medium uppercase tracking-[0.14em] text-[#150D3A]/50">Client</th>
                <th class="px-5 py-3 font-[JetBrains_Mono] text-[10px] font-medium uppercase tracking-[0.14em] text-[#150D3A]/50">Email</th>
                <th class="px-5 py-3 font-[JetBrains_Mono] text-[10px] font-medium uppercase tracking-[0.14em] text-[#150D3A]/50">Phone</th>
                <th class="px-5 py-3 font-[JetBrains_Mono] text-[10px] font-medium uppercase tracking-[0.14em] text-[#150D3A]/50">Location</th>
                <th class="px-5 py-3 font-[JetBrains_Mono] text-[10px] font-medium uppercase tracking-[0.14em] text-[#150D3A]/50">Added</th>
                <th class="px-5 py-3 text-right"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>

            <tbody>
              <% @clients.each do |client| %>
                <tr class="border-b border-[#150D3A]/6 transition last:border-0 hover:bg-[#F7F4FB]/70">

                  <td class="px-5 py-3.5">
                    <div class="flex items-center gap-3">
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[#7620B1] to-[#FC8027] font-[Outfit] text-[13px] font-bold text-white">
                        <%= client.name.to_s.first&.upcase %>
                      </span>
                      <%= link_to client.name, onboarding_client_path(client),
                            class: "font-[Outfit] font-semibold text-[#150D3A] hover:text-[#7620B1] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1] rounded" %>
                    </div>
                  </td>

                  <td class="px-5 py-3.5">
                    <% if client.email.present? %>
                      <span class="font-[JetBrains_Mono] text-xs text-[#150D3A]/70"><%= client.email %></span>
                    <% else %>
                      <span class="text-[#150D3A]/30">—</span>
                    <% end %>
                  </td>

                  <td class="px-5 py-3.5">
                    <% if client.phone.present? %>
                      <span class="font-[JetBrains_Mono] text-xs text-[#150D3A]/70"><%= client.phone %></span>
                    <% else %>
                      <span class="text-[#150D3A]/30">—</span>
                    <% end %>
                  </td>

                  <td class="px-5 py-3.5 text-[#150D3A]/70">
                    <%= [client.city, client.country].compact_blank.join(", ").presence ||
                          content_tag(:span, "—", class: "text-[#150D3A]/30") %>
                  </td>

                  <td class="px-5 py-3.5 text-[#150D3A]/55">
                    <%= client.created_at&.strftime("%-d %b %Y") || "—" %>
                  </td>

                  <td class="px-5 py-3.5 text-right">
                    <%= link_to "Edit", edit_onboarding_client_path(client),
                          class: "rounded-full px-3 py-1.5 text-sm font-medium text-[#7620B1] transition hover:bg-[#7620B1]/8 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1]" %>
                  </td>
                </tr>
              <% end %>
            </tbody>

          </table>
          <%= render "onboarding/clients/pagination" %>

        </div>
      </div>

    <% else %>

      <%# ── Empty state ────────────────────────────────────── %>
      <div class="mt-6 rounded-2xl border border-dashed border-[#150D3A]/20 bg-white/60 px-6 py-16 text-center">
        <h2 class="font-[Outfit] text-xl font-semibold text-[#150D3A]">
          <%= params[:q].present? ? "No clients match that search" : "No clients yet" %>
        </h2>
        <p class="mx-auto mt-2 max-w-sm text-sm text-[#150D3A]/60">
          <% if params[:q].present? %>
            Try a different name, email or phone number.
          <% else %>
            Add the organisers and companies you sell events for, and their details stay one click away.
          <% end %>
        </p>

        <% if params[:q].present? %>
          <%= link_to "Clear search", onboarding_clients_path,
                class: "mt-6 inline-flex rounded-full px-5 py-2.5 text-sm font-semibold text-[#7620B1] border border-[#7620B1] ring-1 ring-[#7620B1]/30 transition hover:bg-[#7620B1]/8" %>
        <% else %>
          <%= link_to "Add a client", new_onboarding_client_path,
                class: "mt-6 inline-flex rounded-full bg-gradient-to-r ]  text-[#7620B1] from-[#7620B1] to-[#FC8027] px-5 py-3 text-sm font-semibold transition hover:brightness-110 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1] focus-visible:ring-offset-2" %>
        <% end %>
      </div>

    <% end %>
  </section>
</div>
