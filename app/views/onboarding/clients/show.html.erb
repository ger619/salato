<%= render 'shared/sidebar' %>

<%
  # ── Readable labels for the stored slugs ──────────────────────────────
  payout_labels   = { "bank" => "Bank", "mobile_money" => "Mobile money" }
  bank_labels     = { "kcb" => "KCB", "co-operative-bank" => "Co-operative Bank",
                      "equity-bank" => "Equity Bank", "absa-bank" => "Absa Bank",
                      "standard-chartered" => "Standard Chartered", "cfc-stanbic" => "CFC Stanbic" }
  provider_labels = { "mpesa" => "M-Pesa", "mpesa-paybill" => "M-Pesa Paybill",
                      "mpesa-till" => "M-Pesa Till", "airtel-money" => "Airtel Money",
                      "telkom-kenya" => "Telkom Kenya" }

  method       = @client.payout_method.to_s
  mobile_money = method == "mobile_money"
  bank_payout  = method == "bank"

  # Works whether description is a plain text column or has_rich_text.
  rich_description = @client.description.respond_to?(:to_plain_text)
  description_text = rich_description ? @client.description.to_plain_text.presence
                       : @client.description.presence

  # ── Rows, grouped into sections ───────────────────────────────────────
  # kind: :text (default), :email, :phone, :rich, :code
  row = ->(label, value, kind = :text) { { label: label, value: value, kind: kind } }

  contact_rows = [
    row.("Email",   @client.email, :email),
    row.("Phone",   @client.phone, :phone),
    row.("Address", @client.address),
    row.("City",    @client.city),
    row.("Country", @client.country)
  ]

  business_rows = [
    row.("Description",      description_text, rich_description ? :rich : :text),
    row.("Registration No.", @client.registration_number)
  ]

  payout_rows = [row.("Payout type", payout_labels.fetch(method, method.presence))]
  # Bank row unless they chose mobile money; provider row unless they chose bank.
  # (If payout type is blank, both show so nothing saved is hidden.)
  unless mobile_money
    payout_rows << row.("Bank", bank_labels.fetch(@client.bank.to_s, @client.bank.presence))
  end
  unless bank_payout
    payout_rows << row.("Mobile money provider",
      provider_labels.fetch(@client.mobile_money_provider.to_s,
                            @client.mobile_money_provider.presence))
  end
  payout_rows << row.(mobile_money ? "Phone / Till / Paybill no." : "Account number",
    @client.account_number, :code)

  platform_rows = [
    row.("Subaccount code", @client.paystack_subaccount_code, :code),
    row.("Platform charge", @client.percentage_charge.nil? ? nil : "#{@client.percentage_charge}%")
  ]

  sections = [
    { title: "Contact",  rows: contact_rows },
    { title: "Business", rows: business_rows },
    { title: "Payout",   rows: payout_rows },
    { title: "Platform", rows: platform_rows }
  ]

  # Plain-text version for "Email details" / "Copy details" — only filled rows.
  details = (["Name: #{@client.name}"] +
    sections.flat_map { |s| s[:rows] }
            .filter_map { |r| "#{r[:label]}: #{r[:value]}" if r[:value].present? }).join("\n")
%>

<div class="mx-auto max-w-2xl px-6 py-10">
  <%= link_to "← Clients", onboarding_clients_path,
              class: "font-[JetBrains_Mono] text-[11px] uppercase tracking-[0.14em] text-[#7620B1] hover:underline" %>

  <%# ── Ticket stub ──────────────────────────────────────────────────── %>
  <article class="mt-4 overflow-hidden rounded-2xl bg-white ring-1 ring-[#150D3A]/10">

    <%# Header: logo, name, meta %>
    <header class="bg-gradient-to-r from-[#7620B1] to-[#FC8027] px-6 pb-8 pt-7 text-center">
      <div class="mx-auto flex h-20 w-20 items-center justify-center overflow-hidden rounded-2xl bg-white/95 ring-4 ring-white/20">
        <% if @client.logo.attached? %>
          <%= image_tag @client.logo,
                        alt: "#{@client.name} logo",
                        class: "h-full w-full object-contain p-2" %>
        <% else %>
          <span class="font-[Outfit] text-2xl font-bold text-[#7620B1]">
            <%= @client.name.to_s.first&.upcase %>
          </span>
        <% end %>
      </div>

      <h1 class="mt-4 font-[Outfit] text-xl font-semibold text-white"><%= @client.name %></h1>

      <p class="mt-1 font-[JetBrains_Mono] text-[11px] uppercase tracking-[0.14em] text-white/70">
        Client since <%= @client.created_at.strftime("%b %Y") %>
        <% if @client.payout_method.present? %>
          · Paid via <%= payout_labels.fetch(@client.payout_method, @client.payout_method) %>
        <% end %>
      </p>
    </header>

    <%# Perforation %>
    <div class="relative">
      <span class="absolute -left-2 top-1/2 h-4 w-4 -translate-y-1/2 rounded-full bg-[#F7F4FB]" aria-hidden="true"></span>
      <span class="absolute -right-2 top-1/2 h-4 w-4 -translate-y-1/2 rounded-full bg-[#F7F4FB]" aria-hidden="true"></span>
      <div class="border-t border-dashed border-[#150D3A]/15"></div>
    </div>

    <%# Details %>
    <div class="px-6">
      <% sections.each do |section| %>
        <section class="border-b border-[#150D3A]/8 py-5 last:border-b-0">
          <h2 class="font-[JetBrains_Mono] text-[10px] uppercase tracking-[0.18em] text-[#7620B1]">
            <%= section[:title] %>
          </h2>

          <dl class="mt-2 divide-y divide-[#150D3A]/8">
            <% section[:rows].each do |r| %>
              <div class="flex flex-col gap-1 py-3 sm:flex-row sm:gap-4">
                <dt class="shrink-0 pt-0.5 font-[JetBrains_Mono] text-[11px] uppercase tracking-[0.14em] text-[#150D3A]/45 sm:w-44">
                  <%= r[:label] %>
                </dt>
                <dd class="min-w-0 flex-1 break-words text-sm text-[#150D3A]">
                  <% if r[:value].blank? %>
                    <span class="text-[#150D3A]/35">Not set</span>
                  <% elsif r[:kind] == :email %>
                    <%= mail_to r[:value], r[:value], class: "text-[#7620B1] hover:underline" %>
                  <% elsif r[:kind] == :phone %>
                    <%= link_to r[:value], "tel:#{r[:value].gsub(/\s+/, '')}", class: "text-[#7620B1] hover:underline" %>
                  <% elsif r[:kind] == :rich %>
                    <div class="prose prose-sm max-w-none text-[#150D3A]"><%= @client.description %></div>
                  <% elsif r[:kind] == :code %>
                    <span class="font-[JetBrains_Mono] text-[13px] tracking-tight"><%= r[:value] %></span>
                  <% else %>
                    <span class="whitespace-pre-line"><%= r[:value] %></span>
                  <% end %>
                </dd>
              </div>
            <% end %>
          </dl>
        </section>
      <% end %>
    </div>
  </article>

  <%# ── Actions ──────────────────────────────────────────────────────── %>
  <div class="mt-5 flex flex-wrap items-center gap-3">
    <%= link_to "Email details",
                "mailto:?subject=#{u("Client details — #{@client.name}")}&body=#{u(details)}",
                class: "rounded-full bg-[#150D3A] px-4 py-2.5 text-sm font-semibold text-white transition hover:brightness-125 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1] focus-visible:ring-offset-2" %>

    <button type="button"
            data-copy-details="<%= details %>"
            class="rounded-full px-4 py-2.5 text-sm font-semibold text-[#7620B1] ring-1 ring-[#7620B1]/30 transition hover:bg-[#7620B1]/8 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7620B1]">
      Copy details
    </button>

    <%= link_to "Edit", edit_onboarding_client_path(@client),
                class: "rounded-full px-4 py-2.5 text-sm font-medium text-[#150D3A]/60 transition hover:bg-[#150D3A]/5" %>
  </div>
</div>

<script>
    // Delegated so it keeps working after Turbo swaps the page in.
    document.addEventListener("click", async (event) => {
        const btn = event.target.closest("[data-copy-details]");
        if (!btn) return;

        const original = btn.textContent;
        try {
            await navigator.clipboard.writeText(btn.dataset.copyDetails);
            btn.textContent = "Copied";
        } catch {
            btn.textContent = "Press Ctrl+C to copy";
        }
        setTimeout(() => { btn.textContent = original; }, 1600);
    });
</script>
